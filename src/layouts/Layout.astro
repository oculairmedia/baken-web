---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import BakenMark from '../components/BakenMark.astro';
import BeaconFooter from '../components/BeaconFooter.astro';
import MarginFogShader from '../components/MarginFogShader.astro';
import { LINKS } from '../lib/brand';

interface Props {
  title?: string;
  description?: string;
  /** Adds SoftwareApplication structured data (home and download pages). */
  appSchema?: boolean;
}

const {
  title = 'Baken: agents that run on your own machine',
  description = 'Baken is a client for persistent AI agents. Agents run on a Linux host you control, keep their memory as plain files, and pair directly with your Android phone.',
  appSchema = false,
} = Astro.props;

// Pages build as directories (/docs/index.html), so canonical URLs end in a slash like the sitemap
const path = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const canonical = new URL(path, Astro.site).href;

const softwareSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Baken',
  description,
  url: 'https://baken.ca/',
  downloadUrl: 'https://baken.ca/download/',
  applicationCategory: 'ProductivityApplication',
  operatingSystem: 'Android 8.0+, Windows x64, Linux x64',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'CAD' },
  publisher: { '@type': 'Organization', name: 'Oculair Media' },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#FAFAFA" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#09090B" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon-180.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Baken" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://baken.ca/og-card-1200x630.png" />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://baken.ca/og-card-1200x630.png" />
    {appSchema && <script type="application/ld+json" set:html={JSON.stringify(softwareSchema)} />}

    <!--
      Audience: "everyone" (default, plain language) or "technical" (full detail). Decided before first
      paint so there is no flash. Order: ?for= in the URL (remembered), then a remembered choice, then a
      utm_source or referrer from a developer site. Both versions are in the HTML; the hero toggle
      switches between them.
    -->
    <script is:inline>
      (function () {
        var TECH_HOSTS = /(^|\.)(github\.com|gitlab\.com|codeberg\.org|news\.ycombinator\.com|lobste\.rs|dev\.to|stackoverflow\.com|huggingface\.co)$/i;
        var TECH_UTM = /^(github|gitlab|hn|hackernews|lobsters|devto|selfhosted|localllama|homelab)/i;
        var aud = null;
        try {
          var q = new URLSearchParams(location.search);
          var forParam = q.get('for');
          if (forParam === 'technical' || forParam === 'everyone') {
            aud = forParam;
            try { localStorage.setItem('baken-audience', aud); } catch (e) {}
          }
          if (!aud) { try { aud = localStorage.getItem('baken-audience'); } catch (e) {} }
          if (aud !== 'technical' && aud !== 'everyone') aud = null;
          // A detected audience lasts for the browser session, so later pages (referrer: baken.ca) keep it
          if (!aud) { try { aud = sessionStorage.getItem('baken-audience-detected'); } catch (e) {} }
          if (aud !== 'technical') aud = aud === 'everyone' ? aud : null;
          var detected = false;
          if (!aud && TECH_UTM.test(q.get('utm_source') || '')) { aud = 'technical'; detected = true; }
          if (!aud && document.referrer) {
            var host = new URL(document.referrer).hostname;
            if (TECH_HOSTS.test(host)) { aud = 'technical'; detected = true; }
          }
          if (detected) { try { sessionStorage.setItem('baken-audience-detected', aud); } catch (e) {} }
        } catch (e) {}
        window.__bakenAudience = aud || 'everyone';
        document.documentElement.dataset.audience = window.__bakenAudience;
        // ClientRouter swaps <html> attributes on navigation; put the audience back each time
        document.addEventListener('astro:after-swap', function () {
          document.documentElement.dataset.audience = window.__bakenAudience;
        });
      })();
    </script>

    <script
      defer
      src="https://metrics.oculair.ca/script.js"
      data-website-id="cabd3ab0-d34d-495b-baec-6808d1118e45"
    ></script>
    <ClientRouter />
  </head>
  <body>
    <div transition:persist="margin-fog">
      <MarginFogShader />
    </div>
    <header class="site-nav" transition:persist="site-nav">
      <div class="container wrap nav-inner">
        <div class="nav-left">
          <a href="/" class="brand-link" aria-label="Baken home">
            <BakenMark uid="nav" size={22} state="idle" tight />
            <span>baken</span>
          </a>

          <nav class="nav-links" aria-label="Main navigation">
            <a href="/#capabilities">What it does</a>
            <a href="/#jobs">Jobs</a>
            <a href="/#ownership">Ownership</a>
            <a href="/#why-baken">Why Baken</a>
            <a href="/docs">Docs</a>
          </nav>
        </div>

        <div class="nav-actions">
          <a
            class="btn btn-nav-ghost"
            href={LINKS.appRepo}
            target="_blank"
            rel="noreferrer"
            aria-label="Baken source on GitHub"
            data-umami-event="github-nav"
          >
            <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 .5C5.65.5.5 5.65.5 12a11.5 11.5 0 0 0 7.86 10.92c.58.1.79-.25.79-.56v-2c-3.2.7-3.87-1.37-3.87-1.37-.53-1.33-1.28-1.69-1.28-1.69-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.68 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.41-2.69 5.38-5.26 5.67.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5Z" />
            </svg>
            <span class="nav-gh-label">GitHub</span>
            <span class="nav-gh-stars" data-gh-stars hidden></span>
          </a>
          <a class="btn btn-nav" href={LINKS.download} data-umami-event="download-nav">
            Download
          </a>
        </div>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <div transition:persist="beacon-footer">
      <BeaconFooter />
    </div>

    <script>
      // Rive (about 1 MB of wasm plus .riv files) waits until the browser is idle so it never competes
      // with first paint, and is skipped for Save-Data visitors. Canvases stay transparent until mounted.
      const saveData = (navigator as any).connection?.saveData === true;
      const whenIdle = (fn: () => void) =>
        'requestIdleCallback' in window
          ? (window as any).requestIdleCallback(fn, { timeout: 2500 })
          : window.setTimeout(fn, 1200);
      // Overview / Technical toggle (any [data-set-aud] button). The choice is remembered for later visits.
      document.addEventListener('click', (ev) => {
        const btn = (ev.target as HTMLElement | null)?.closest<HTMLElement>('[data-set-aud]');
        if (!btn) return;
        const aud = btn.dataset.setAud === 'technical' ? 'technical' : 'everyone';
        (window as any).__bakenAudience = aud;
        document.documentElement.dataset.audience = aud;
        try { localStorage.setItem('baken-audience', aud); } catch {}
        try { (window as any).umami?.track('audience-switch', { audience: aud }); } catch {}
      });

      // Star count on the nav GitHub button: shown only once it is social proof rather than a liability
      const STAR_THRESHOLD = 100;
      async function showStars() {
        const el = document.querySelector<HTMLElement>('[data-gh-stars]');
        if (!el) return;
        let stars: number | null = null;
        try { const c = sessionStorage.getItem('baken-gh-stars'); if (c) stars = Number(c); } catch {}
        if (stars === null) {
          try {
            const res = await fetch('https://api.github.com/repos/oculairmedia/letta-mobile');
            if (res.ok) stars = (await res.json()).stargazers_count ?? null;
            if (stars !== null) { try { sessionStorage.setItem('baken-gh-stars', String(stars)); } catch {} }
          } catch {}
        }
        if (stars === null || stars < STAR_THRESHOLD) return;
        el.textContent = stars >= 1000 ? `${(stars / 1000).toFixed(stars >= 10000 ? 0 : 1)}k` : String(stars);
        el.hidden = false;
      }
      document.addEventListener('astro:page-load', () => {
        if (!saveData) whenIdle(showStars);
        if (saveData) return;
        whenIdle(() => import('../lib/rive-host').then((m) => m.initRiveHost()));
      });
    </script>
  </body>
</html>
