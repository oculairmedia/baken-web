---
import '../styles/global.css';
import BakenMark from '../components/BakenMark.astro';
import { LINKS } from '../lib/brand';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Baken — Your companion, on every screen',
  description = 'Open-source, local-first agent client for Android and Desktop with persistent memory, peer-to-peer Iroh pairing, and living Rive mascots.',
} = Astro.props;
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0D1821" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon-180.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Baken" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://baken.ca/og-card-1200x630.png" />
    <meta property="og:url" content="https://baken.ca" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://baken.ca/og-card-1200x630.png" />

    <script
      defer
      src="https://metrics.oculair.ca/script.js"
      data-website-id="cabd3ab0-d34d-495b-baec-6808d1118e45"
    ></script>

    <script is:inline>
      try {
        const saved = localStorage.getItem('baken-theme');
        if (saved === 'light' || saved === 'dark') {
          document.documentElement.dataset.theme = saved;
        }
      } catch {}
    </script>
  </head>
  <body>
    <header class="site-nav">
      <div class="container nav-inner">
        <a href="/" class="brand-link" aria-label="Baken home">
          <BakenMark uid="nav" size={32} state="idle" />
          <span>baken</span>
        </a>

        <nav class="nav-links" aria-label="Main navigation">
          <a href="/#architecture">Architecture</a>
          <a href="/#presence">Motion &amp; Mascots</a>
          <a href="/docs">Docs</a>
          <a href={LINKS.appRepo} target="_blank" rel="noreferrer">GitHub</a>
        </nav>

        <div class="nav-actions">
          <button id="themeToggle" class="btn btn-ghost" type="button" aria-label="Toggle theme">
            Light / Dark
          </button>
          <a class="btn btn-primary" href={LINKS.releases} target="_blank" rel="noreferrer">
            Download
          </a>
        </div>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container footer-inner">
        <div style="display:flex;align-items:center;gap:10px;">
          <BakenMark uid="ftr" size={22} state="idle" />
          <span><strong style="color:var(--text)">baken.ca</strong> · Open-source companion client · Oculair Media</span>
        </div>
        <div class="footer-links">
          <a href="/docs">Docs</a>
          <a href={LINKS.releases} target="_blank" rel="noreferrer">Releases</a>
          <a href={LINKS.appRepo} target="_blank" rel="noreferrer">App Repo</a>
          <a href={LINKS.webRepo} target="_blank" rel="noreferrer">Site Repo</a>
        </div>
      </div>
    </footer>

    <script is:inline>
      const btn = document.getElementById('themeToggle');
      btn?.addEventListener('click', () => {
        const next = document.documentElement.dataset.theme === 'light' ? 'dark' : 'light';
        document.documentElement.dataset.theme = next;
        try { localStorage.setItem('baken-theme', next); } catch {}
      });
    </script>
  </body>
</html>
