---
import '../styles/global.css';
import BakenMark from '../components/BakenMark.astro';
import { LINKS } from '../lib/brand';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Baken — AI agents that finish the work and stay yours.',
  description = 'Give each agent a real job. They work on your computer, remember what matters, and stay with you on your phone — free, open source, and impossible to take away.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#EFF3F6" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0D1821" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon-180.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Baken" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://baken.ca/og-card-1200x630.png" />
    <meta property="og:url" content="https://baken.ca" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://baken.ca/og-card-1200x630.png" />

    <script
      defer
      src="https://metrics.oculair.ca/script.js"
      data-website-id="cabd3ab0-d34d-495b-baec-6808d1118e45"
    ></script>
  </head>
  <body>
    <header class="site-nav">
      <div class="container nav-inner">
        <div class="nav-left">
          <a href="/" class="brand-link" aria-label="Baken home">
            <BakenMark uid="nav" size={22} state="idle" tight />
            <span>baken</span>
          </a>

          <nav class="nav-links" aria-label="Main navigation">
            <a href="/#capabilities">What it does</a>
            <a href="/#jobs">Jobs</a>
            <a href="/#ownership">Ownership</a>
            <a href="/#why-baken">Why Baken</a>
            <a href="/docs">Docs</a>
          </nav>
        </div>

        <div class="nav-actions">
          <a class="btn btn-nav" href={LINKS.releases} target="_blank" rel="noreferrer" data-umami-event="download-nav">
            Download
          </a>
        </div>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container footer-inner">
        <div style="display:flex;align-items:center;gap:7px;">
          <BakenMark uid="ftr" size={17} state="idle" tight />
          <span><strong style="color:var(--text)">baken</strong> — a fixed mark on water that shifts</span>
        </div>
        <div class="footer-links">
          <a href="/docs">Docs</a>
          <a href="/llms.txt">llms.txt</a>
          <a href={LINKS.releases} target="_blank" rel="noreferrer">Releases</a>
          <a href={LINKS.appRepo} target="_blank" rel="noreferrer">GitHub</a>
          <a href={LINKS.webRepo} target="_blank" rel="noreferrer">Site Repo</a>
        </div>
      </div>
    </footer>
  </body>
</html>
