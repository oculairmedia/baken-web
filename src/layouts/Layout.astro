---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import BakenMark from '../components/BakenMark.astro';
import BeaconFooter from '../components/BeaconFooter.astro';
import MarginFogShader from '../components/MarginFogShader.astro';
import { LINKS } from '../lib/brand';

interface Props {
  title?: string;
  description?: string;
  /** Adds SoftwareApplication structured data (home and download pages). */
  appSchema?: boolean;
}

const {
  title = 'Baken: agents that run on your own machine',
  description = 'Baken is a client for persistent AI agents. Agents run on a Linux or Windows host you control, keep their memory as plain files, and pair directly with your Android phone.',
  appSchema = false,
} = Astro.props;

// Pages build as directories (/docs/index.html), so canonical URLs end in a slash like the sitemap
const path = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const canonical = new URL(path, Astro.site).href;

const softwareSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Baken',
  description,
  url: 'https://baken.ca/',
  downloadUrl: 'https://baken.ca/download/',
  applicationCategory: 'ProductivityApplication',
  operatingSystem: 'Android 8.0+, Windows x64, Linux x64',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'CAD' },
  publisher: { '@type': 'Organization', name: 'Oculair Media' },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#FAFAFA" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#09090B" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon-180.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Baken" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://baken.ca/og-card-1200x630.png" />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://baken.ca/og-card-1200x630.png" />
    {appSchema && <script type="application/ld+json" set:html={JSON.stringify(softwareSchema)} />}

    <script
      defer
      src="https://metrics.oculair.ca/script.js"
      data-website-id="cabd3ab0-d34d-495b-baec-6808d1118e45"
    ></script>
    <ClientRouter />
  </head>
  <body>
    <div transition:persist="margin-fog">
      <MarginFogShader />
    </div>
    <header class="site-nav" transition:persist="site-nav">
      <div class="container wrap nav-inner">
        <div class="nav-left">
          <a href="/" class="brand-link" aria-label="Baken home">
            <BakenMark uid="nav" size={22} state="idle" tight />
            <span>baken</span>
          </a>

          <nav class="nav-links" aria-label="Main navigation">
            <a href="/#capabilities">What it does</a>
            <a href="/#jobs">Jobs</a>
            <a href="/#ownership">Ownership</a>
            <a href="/#why-baken">Why Baken</a>
            <a href="/docs">Docs</a>
          </nav>
        </div>

        <div class="nav-actions">
          <a class="btn btn-nav" href={LINKS.download} data-umami-event="download-nav">
            Download
          </a>
        </div>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <div transition:persist="beacon-footer">
      <BeaconFooter />
    </div>

    <script>
      // Rive (about 1 MB of wasm plus .riv files) waits until the browser is idle so it never competes
      // with first paint, and is skipped for Save-Data visitors. Canvases stay transparent until mounted.
      const saveData = (navigator as any).connection?.saveData === true;
      const whenIdle = (fn: () => void) =>
        'requestIdleCallback' in window
          ? (window as any).requestIdleCallback(fn, { timeout: 2500 })
          : window.setTimeout(fn, 1200);
      document.addEventListener('astro:page-load', () => {
        if (saveData) return;
        whenIdle(() => import('../lib/rive-host').then((m) => m.initRiveHost()));
      });
    </script>
  </body>
</html>
