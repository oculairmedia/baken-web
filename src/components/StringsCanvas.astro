---
// Full-bleed elastic strings board:
// - Strings run edge-to-edge across the entire viewport (100vw, never cut off in a box)
// - Nodes represent human/life things you own (not protocol jargon)
// - Drag any node to stretch the strings; release and it springs back home with real harmonic snap-back
---

<section class="strings-band dark-surface" id="ownership" aria-label="Interactive ownership board">
  <div class="strings-head container">
    <h2>No one else should hold<br />the strings to your</h2>
    <p class="strings-hint">pull any block and let go — everything snaps back to your side</p>
  </div>

  <div class="strings-stage" id="stringsStage">
    <svg class="strings-svg" id="stringsSvg" aria-hidden="true"></svg>

    <div class="strings-inner" id="stringsInner">
      <!-- Row 1 -->
      <div class="s-node muted" data-id="r1-0" data-col="0" style="--x:23%;--y:19%">
        <span class="dot l"></span>
        <span>Working style</span>
        <span class="dot r"></span>
      </div>
      <div class="s-node primary" data-id="r1-1" data-col="1" style="--x:50%;--y:19%">
        <span class="dot l"></span>
        <span class="n-ico" aria-hidden="true">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1 0-5H20"/></svg>
        </span>
        <span>Long-term memory</span>
        <span class="dot r"></span>
      </div>
      <div class="s-node muted" data-id="r1-2" data-col="2" style="--x:77%;--y:19%">
        <span class="dot l"></span>
        <span>Past decisions</span>
        <span class="dot r"></span>
      </div>

      <!-- Row 2 -->
      <div class="s-node primary" data-id="r2-0" data-col="0" style="--x:26%;--y:41%">
        <span class="dot l"></span>
        <span class="n-ico" aria-hidden="true">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/></svg>
        </span>
        <span>Files &amp; notes</span>
        <span class="dot r"></span>
      </div>
      <div class="s-node primary" data-id="r2-1" data-col="1" style="--x:52%;--y:41%">
        <span class="dot l"></span>
        <span class="n-ico" aria-hidden="true">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg>
        </span>
        <span>Your companion's voice</span>
        <span class="dot r"></span>
      </div>
      <div class="s-node muted" data-id="r2-2" data-col="2" style="--x:78%;--y:41%">
        <span class="dot l"></span>
        <span>Daily routines</span>
        <span class="dot r"></span>
      </div>

      <!-- Row 3 -->
      <div class="s-node muted" data-id="r3-0" data-col="0" style="--x:21%;--y:63%">
        <span class="dot l"></span>
        <span>Half-finished ideas</span>
        <span class="dot r"></span>
      </div>
      <div class="s-node primary" data-id="r3-1" data-col="1" style="--x:45%;--y:63%">
        <span class="dot l"></span>
        <span class="n-ico" aria-hidden="true">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="7.5" cy="15.5" r="4.5"/><path d="m21 2-9.6 9.6"/><path d="m15.5 7.5 3 3L22 7l-3-3"/></svg>
        </span>
        <span>Private keys</span>
        <span class="dot r"></span>
      </div>
      <div class="s-node primary" data-id="r3-2" data-col="2" style="--x:69%;--y:63%">
        <span class="dot l"></span>
        <span class="n-ico" aria-hidden="true">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
        </span>
        <span>Private code</span>
        <span class="dot r"></span>
      </div>

      <!-- Row 4 -->
      <div class="s-node muted" data-id="r4-0" data-col="0" style="--x:29%;--y:84%">
        <span class="dot l"></span>
        <span>Conversations</span>
        <span class="dot r"></span>
      </div>
      <div class="s-node muted" data-id="r4-1" data-col="1" style="--x:53%;--y:84%">
        <span class="dot l"></span>
        <span>Background work</span>
        <span class="dot r"></span>
      </div>
      <div class="s-node muted" data-id="r4-2" data-col="2" style="--x:76%;--y:84%">
        <span class="dot l"></span>
        <span>What matters to you</span>
        <span class="dot r"></span>
      </div>
    </div>
  </div>
</section>

<style>
  .strings-band {
    position: relative;
    width: 100%;
    background: #070709;
    color: #F4F4F6;
    padding: 96px 0 64px;
    overflow: hidden;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .strings-head {
    text-align: center;
    position: relative;
    z-index: 2;
    margin-bottom: 18px;
  }

  .strings-head h2 {
    margin: 0;
    font-size: clamp(34px, 4.6vw, 54px);
    line-height: 1.07;
    letter-spacing: -0.04em;
    font-weight: 700;
    color: #FFFFFF;
  }

  .strings-hint {
    margin: 14px 0 0;
    font-size: 13px;
    color: #7A7A84;
  }

  /* Full viewport width so the strings always reach the literal left/right edges of the window */
  .strings-stage {
    position: relative;
    width: 100vw;
    left: 50%;
    transform: translateX(-50%);
    height: 410px;
    user-select: none;
    touch-action: none;
  }

  .strings-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    overflow: visible;
  }

  .strings-inner {
    position: relative;
    width: 100%;
    max-width: 1120px;
    height: 100%;
    margin: 0 auto;
  }

  .s-node {
    position: absolute;
    left: var(--x);
    top: var(--y);
    transform: translate3d(-50%, -50%, 0);
    display: inline-flex;
    align-items: center;
    gap: 9px;
    padding: 11px 17px;
    border-radius: 4px;
    font-size: 15.5px;
    line-height: 1;
    white-space: nowrap;
    cursor: grab;
    z-index: 2;
    will-change: transform;
    transition: border-color 140ms ease, box-shadow 140ms ease;
  }

  .s-node.primary {
    background: #121215;
    border: 1px solid rgba(255, 255, 255, 0.14);
    color: #F4F4F6;
    font-weight: 700;
    box-shadow: 0 10px 26px rgba(0, 0, 0, 0.45);
  }

  .s-node.muted {
    background: rgba(18, 18, 22, 0.88);
    border: 1px solid rgba(255, 255, 255, 0.08);
    color: #82828D;
    font-weight: 500;
  }

  .s-node:hover {
    border-color: rgba(238, 90, 63, 0.55);
    z-index: 5;
  }

  .s-node.dragging {
    cursor: grabbing;
    border-color: #EE5A3F;
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.6), 0 0 0 1px rgba(238, 90, 63, 0.4);
    z-index: 10;
  }

  .n-ico {
    display: inline-flex;
    color: #EE5A3F;
  }

  .dot {
    position: absolute;
    top: 50%;
    width: 5px;
    height: 5px;
    background: #D4D4DC;
    transform: translateY(-50%);
    pointer-events: none;
  }
  .s-node.muted .dot { background: #52525B; }
  .s-node.dragging .dot { background: #EE5A3F; }
  .dot.l { left: -3px; }
  .dot.r { right: -3px; }

  @media (max-width: 820px) {
    .strings-stage { height: 460px; }
    .s-node { font-size: 13px; padding: 8px 12px; }
  }
</style>

<script is:inline>
  (function () {
    const stage = document.getElementById('stringsStage');
    const inner = document.getElementById('stringsInner');
    const svg = document.getElementById('stringsSvg');
    if (!stage || !inner || !svg) return;

    const nodes = Array.from(inner.querySelectorAll('.s-node'));
    const byId = Object.fromEntries(nodes.map((n) => [n.dataset.id, n]));

    // Continuous edge-to-edge strings + cross-tethers (all anchored at x=0 and x=viewportWidth)
    const rows = [
      { ids: ['r1-0', 'r1-1', 'r1-2'], leftY: 0.05, rightY: 0.13 },
      { ids: ['r2-0', 'r2-1', 'r2-2'], leftY: 0.30, rightY: 0.46 },
      { ids: ['r3-0', 'r3-1', 'r3-2'], leftY: 0.67, rightY: 0.55 },
      { ids: ['r4-0', 'r4-1', 'r4-2'], leftY: 0.94, rightY: 0.89 },
    ];

    const crossEdges = [
      { from: 'left', y: 0.16, to: 'r2-0', side: 'l' },
      { from: 'left', y: 0.46, to: 'r2-0', side: 'l' },
      { from: 'left', y: 0.78, to: 'r3-0', side: 'l' },
      { from: 'r1-2', side: 'r', to: 'right', y: 0.32 },
      { from: 'r3-2', side: 'r', to: 'right', y: 0.76 },
    ];

    // Spring physics state per node: { dx, dy, vx, vy, dragging }
    const phys = new Map();
    nodes.forEach((el) => phys.set(el, { dx: 0, dy: 0, vx: 0, vy: 0, dragging: false }));

    function applyTransform(el, p) {
      el.style.transform = `translate3d(calc(-50% + ${p.dx.toFixed(2)}px), calc(-50% + ${p.dy.toFixed(2)}px), 0)`;
    }

    function anchorPoint(el, side, stageRect) {
      const r = el.getBoundingClientRect();
      const y = r.top - stageRect.top + r.height / 2;
      const x = side === 'l' ? r.left - stageRect.left : r.right - stageRect.left;
      return { x, y };
    }

    function draw() {
      const stageRect = stage.getBoundingClientRect();
      const W = stageRect.width;
      const H = stageRect.height;
      svg.setAttribute('viewBox', `0 0 ${W} ${H}`);

      const lines = [];
      const isHot = (el) => {
        const p = phys.get(el);
        return p && (p.dragging || Math.hypot(p.dx, p.dy) > 3);
      };

      const addLine = (x1, y1, x2, y2, hot) => {
        const stroke = hot ? 'rgba(238, 90, 63, 0.88)' : 'rgba(255, 255, 255, 0.13)';
        const sw = hot ? 1.6 : 1;
        lines.push(
          `<line x1="${x1.toFixed(1)}" y1="${y1.toFixed(1)}" x2="${x2.toFixed(1)}" y2="${y2.toFixed(1)}" stroke="${stroke}" stroke-width="${sw}" />`
        );
      };

      rows.forEach((row) => {
        const els = row.ids.map((id) => byId[id]).filter(Boolean);
        if (!els.length) return;
        const firstL = anchorPoint(els[0], 'l', stageRect);
        addLine(0, row.leftY * H, firstL.x, firstL.y, isHot(els[0]));
        for (let i = 0; i < els.length - 1; i++) {
          const p1 = anchorPoint(els[i], 'r', stageRect);
          const p2 = anchorPoint(els[i + 1], 'l', stageRect);
          addLine(p1.x, p1.y, p2.x, p2.y, isHot(els[i]) || isHot(els[i + 1]));
        }
        const lastR = anchorPoint(els[els.length - 1], 'r', stageRect);
        addLine(lastR.x, lastR.y, W, row.rightY * H, isHot(els[els.length - 1]));
      });

      crossEdges.forEach((ce) => {
        if (ce.from === 'left') {
          const target = byId[ce.to];
          if (!target) return;
          const p = anchorPoint(target, ce.side, stageRect);
          addLine(0, ce.y * H, p.x, p.y, isHot(target));
        } else {
          const src = byId[ce.from];
          if (!src) return;
          const p = anchorPoint(src, ce.side, stageRect);
          addLine(p.x, p.y, W, ce.y * H, isHot(src));
        }
      });

      svg.innerHTML = lines.join('');
    }

    // Damped harmonic spring loop so released blocks snap back home with an elastic bounce
    let rafId = null;
    function stepPhysics() {
      let moving = false;
      const K = 0.16;       // spring stiffness
      const DAMP = 0.76;    // velocity damping (underdamped so it gives one crisp elastic snap)

      nodes.forEach((el) => {
        const p = phys.get(el);
        if (!p) return;
        if (p.dragging) {
          moving = true;
          return;
        }
        if (Math.abs(p.dx) > 0.15 || Math.abs(p.dy) > 0.15 || Math.abs(p.vx) > 0.15 || Math.abs(p.vy) > 0.15) {
          p.vx = (p.vx - p.dx * K) * DAMP;
          p.vy = (p.vy - p.dy * K) * DAMP;
          p.dx += p.vx;
          p.dy += p.vy;
          applyTransform(el, p);
          moving = true;
        } else if (p.dx !== 0 || p.dy !== 0) {
          p.dx = 0;
          p.dy = 0;
          p.vx = 0;
          p.vy = 0;
          applyTransform(el, p);
        }
      });

      draw();
      if (moving) {
        rafId = requestAnimationFrame(stepPhysics);
      } else {
        rafId = null;
      }
    }

    function ensureLoop() {
      if (rafId === null) rafId = requestAnimationFrame(stepPhysics);
    }

    nodes.forEach((el) => {
      let startX = 0, startY = 0, baseDx = 0, baseDy = 0, pid = null;

      el.addEventListener('pointerdown', (e) => {
        e.preventDefault();
        const p = phys.get(el);
        pid = e.pointerId;
        el.setPointerCapture(pid);
        p.dragging = true;
        p.vx = 0;
        p.vy = 0;
        startX = e.clientX;
        startY = e.clientY;
        baseDx = p.dx;
        baseDy = p.dy;
        el.classList.add('dragging');
        ensureLoop();
      });

      el.addEventListener('pointermove', (e) => {
        const p = phys.get(el);
        if (pid !== e.pointerId || !p?.dragging) return;
        // Soft rubber-band resistance beyond 180px
        const rawX = baseDx + (e.clientX - startX);
        const rawY = baseDy + (e.clientY - startY);
        p.dx = Math.max(-240, Math.min(240, rawX * 0.92));
        p.dy = Math.max(-160, Math.min(160, rawY * 0.92));
        applyTransform(el, p);
        ensureLoop();
      });

      const release = (e) => {
        const p = phys.get(el);
        if (pid !== e.pointerId || !p) return;
        try { el.releasePointerCapture(pid); } catch {}
        pid = null;
        p.dragging = false;
        el.classList.remove('dragging');
        ensureLoop();
      };
      el.addEventListener('pointerup', release);
      el.addEventListener('pointercancel', release);
    });

    window.addEventListener('resize', draw);
    requestAnimationFrame(draw);
  })();
</script>
