<script is:inline>
  // Role Switcher ("Give each agent a job")
  const jobPills = document.querySelectorAll('#jobPills .job-pill');
  const jobPanels = document.querySelectorAll('#jobStage .job-panel');
  jobPills.forEach((btn) => {
    btn.addEventListener('click', () => {
      const target = btn.getAttribute('data-job');
      jobPills.forEach((b) => {
        const active = b === btn;
        b.classList.toggle('active', active);
        b.setAttribute('aria-selected', String(active));
      });
      jobPanels.forEach((p) => p.classList.toggle('active', p.getAttribute('data-panel') === target));
    });
  });

  // Mascot pointer gaze + bottom Wadden Sea Transit Sightline
  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const rear = document.getElementById('rearStone');
    const front = document.getElementById('frontStone');
    const ray = document.getElementById('sightRay');
    const glow = document.getElementById('sightGlow');
    const readout = document.getElementById('transitReadout');

    window.addEventListener('pointermove', (e) => {
      const nx = (e.clientX / window.innerWidth) * 2 - 1;
      const ny = (e.clientY / window.innerHeight) * 2 - 1;

      document.querySelectorAll('.m-gaze').forEach((g) => {
        g.setAttribute('transform', `translate(${(nx * 12).toFixed(1)}, ${(ny * 9).toFixed(1)})`);
      });

      if (rear && front && ray && glow && readout) {
        const rearDx = nx * 6;
        const frontDx = nx * 20;
        rear.setAttribute('transform', `translate(${(202 + rearDx).toFixed(1)}, 24) scale(0.78)`);
        front.setAttribute('transform', `translate(${(202 + frontDx).toFixed(1)}, 24) scale(0.78)`);
        ray.setAttribute('x1', (280 + rearDx).toFixed(1));
        ray.setAttribute('x2', (280 + frontDx * 1.3).toFixed(1));

        const driftDeg = Math.abs(nx * 4.2);
        const aligned = driftDeg < 0.8;
        glow.setAttribute('opacity', aligned ? '1' : '0.35');
        ray.setAttribute('stroke', aligned ? 'rgba(238,90,63,0.85)' : 'rgba(220,230,238,0.28)');
        readout.textContent = aligned
          ? `Bearing aligned · ${driftDeg.toFixed(1)}° drift`
          : `Sighting transit · ${driftDeg.toFixed(1)}° offset`;
      }
    });
  }
</script>
