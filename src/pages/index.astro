---
import Layout from '../layouts/Layout.astro';
import BakenMark from '../components/BakenMark.astro';
import RiveMascot from '../components/RiveMascot.astro';
import RiveBakenMark from '../components/RiveBakenMark.astro';
import MooringCanvas from '../components/MooringCanvas.astro';
import PixelStageShader from '../components/PixelStageShader.astro';
import { LINKS, BAKEN_ANCHOR, BAKEN_PEBBLE } from '../lib/brand';
---

<Layout appSchema>
  <!-- 1. HERO: WHAT IT DOES + LIVE RIVE CAST + FULL PRODUCT WINDOW -->
  <section class="hero">
    <div class="container wrap hero-center">
      <!-- Real mascot.riv + baken_mark.riv cast row (same binaries shipped in the app) -->
      <div class="mascot-lineup">
        <div class="m-chip" title="Meridian: hover or poke">
          <RiveMascot size={84} shape="blob" color="#1E7BF0" state="idle" title="Meridian" />
        </div>
        <div class="m-chip" title="Builder: hover or poke">
          <RiveMascot size={84} shape="triangle" color="#FF6A1A" state="working" title="Builder" />
        </div>
        <div class="m-chip m-mark" title="Baken: click to lock">
          <RiveBakenMark size={64} state="ambient" theme="auto" boot={true} title="Baken mark" />
        </div>
        <div class="m-chip" title="Planner: hover or poke">
          <RiveMascot size={84} shape="roundedSquare" color="#1DA34A" state="thinking" title="Planner" />
        </div>
        <div class="m-chip" title="Archivist: hover or poke">
          <RiveMascot size={84} shape="circle" color="#E5484D" state="idle" title="Archivist" />
        </div>
      </div>

      <h1>Agents that run on<br class="h1-break" /> your own machine.</h1>

      <p class="hero-lead" data-aud="everyone">
        Baken is a personal AI assistant that lives on your own computer and comes with you on your phone. It remembers what matters to you, works with your files and apps, and keeps what it learns on your machine, not on someone else's server.
      </p>
      <p class="hero-lead" data-aud="technical">
        A native Android, Windows and Linux client for stateful agents on a host you run. letta-code runtime, plain-file memory on disk, MCP tools and any model provider or local inference, paired over end-to-end encrypted Iroh QUIC. No account, no Baken server, source available.
      </p>

      <div class="hero-cta-row">
        <a class="btn btn-primary" href={LINKS.download} data-umami-event="download-hero">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 3v12m0 0 4.5-4.5M12 15 7.5 10.5M4 20h16" />
          </svg>
          Download for Android, Windows &amp; Linux
        </a>
        <a class="btn btn-outline" href="#capabilities" data-aud="everyone">
          See what they do
        </a>
        <a class="btn btn-outline" href="#under-the-hood" data-aud="technical">
          Under the hood
        </a>
      </div>
      <p class="hero-req">Needs a Linux or Windows computer to run your agents. <a href="/download#host">What the host needs</a></p>
      <div class="aud-toggle" role="group" aria-label="How much detail to show">
        <button type="button" data-set-aud="everyone">Overview</button>
        <button type="button" data-set-aud="technical">Technical</button>
      </div>
    </div>
  </section>

  <!-- 1b. PRODUCT SHOWCASE: ACCURATE BAKEN DESKTOP WINDOW -->
  <section class="showcase-band" id="showcase" aria-label="The Baken desktop app">
    <div class="container wrap">
      <div class="showcase-stage dark-surface">
        <PixelStageShader />
        <div class="app-window">
          <div class="win-titlebar">
            <div class="win-left">
              <span class="win-toggle" aria-hidden="true">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="3"/><path d="M9 3v18"/></svg>
              </span>
              <span class="win-tab active-tab">
                <strong>Store domain &amp; launch</strong>
                <span class="win-tab-agent">Meridian</span>
                <span class="win-tab-x" aria-hidden="true">×</span>
              </span>
              <span class="win-tab-add" aria-hidden="true">+</span>
            </div>
            <div class="win-right">
              <div class="win-search">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
                <span>Search…</span>
              </div>
              <div class="win-controls" aria-hidden="true">
                <span>−</span><span>□</span><span>×</span>
              </div>
            </div>
          </div>

          <div class="win-body">
            <aside class="win-rail" aria-label="Agent rail">
              <div class="rail-brand" title="Home">
                <BakenMark uid="win-rail-mark" size={22} state="idle" tight />
              </div>
              <div class="rail-icon rail-selected" title="Meridian">
                <RiveMascot size={46} shape="blob" color="#1E7BF0" state="idle" title="Meridian" />
              </div>
              <div class="rail-icon" title="Builder">
                <RiveMascot size={46} shape="triangle" color="#FF6A1A" state="working" title="Builder" />
              </div>
              <div class="rail-icon" title="Planner">
                <RiveMascot size={46} shape="roundedSquare" color="#1DA34A" state="idle" title="Planner" />
              </div>
              <div class="rail-icon" title="Archivist">
                <RiveMascot size={46} shape="circle" color="#E5484D" state="idle" title="Archivist" />
              </div>
              <div class="rail-spacer"></div>
              <div class="rail-add" aria-hidden="true">+</div>
            </aside>

            <aside class="win-sidebar">
              <div class="agent-hero">
                <span class="agent-more" aria-hidden="true">⋮</span>
                <RiveMascot size={92} shape="blob" color="#1E7BF0" state="idle" title="Meridian — poke to react" />
                <strong>Meridian</strong>
              </div>

              <div class="ctx-card">
                <div class="ctx-model">
                  <span>qwen3-coder · local</span>
                  <span aria-hidden="true">▾</span>
                </div>
                <div class="ctx-bar"><span style="width:20%"></span></div>
                <div class="ctx-meta">20% of context used</div>
              </div>

              <div class="side-nav">
                <div class="side-item">
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 8v4l2.5 2.5"/></svg>
                  <span>Memory</span>
                </div>
                <div class="side-item">
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>
                  <span>Schedules</span>
                </div>
                <div class="side-item">
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" aria-hidden="true"><circle cx="6" cy="12" r="2.5"/><circle cx="18" cy="6" r="2.5"/><circle cx="18" cy="18" r="2.5"/><path d="M8.3 11 15.7 7M8.3 13l7.4 4"/></svg>
                  <span>Channels</span>
                </div>
                <div class="side-item">
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" aria-hidden="true"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
                  <span>Skills</span>
                </div>
                <div class="side-item">
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" aria-hidden="true"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg>
                  <span>New chat</span>
                </div>
              </div>

              <div class="side-threads">
                <div class="side-filter" aria-hidden="true">
                  <span class="sf-active">Active</span>
                  <span>Archived</span>
                  <span>All</span>
                </div>
                <div class="thread active-thread">
                  <span class="t-name">Store domain &amp; launch</span>
                  <span class="t-age">30m</span>
                </div>
                <div class="thread">
                  <span class="t-name">Living room TV setup</span>
                  <span class="t-age">11h</span>
                </div>
                <div class="thread">
                  <span class="t-name">Monthly budget check</span>
                  <span class="t-age">20h</span>
                </div>
              </div>

              <div class="side-bottom">
                <div class="side-item">
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" aria-hidden="true"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9c.26.6.85 1 1.51 1H21a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1Z"/></svg>
                  <span>Settings</span>
                </div>
              </div>
            </aside>

            <div class="win-chat">
              <div class="chat-column">
                <div class="chat-feed">
                  <div class="msg-user">
                    <p>Point the new shop domain at the storefront, set up a support@ address, and make sure my personal email isn't on any public page.</p>
                  </div>

                  <div class="work-disclosure">
                    <span class="work-chev" aria-hidden="true">▸</span>
                    <span>Worked · 3 tools · 18s</span>
                  </div>

                  <div class="msg-agent">
                    <p>Done and verified live across the homepage, contact page, privacy policy, and terms:</p>
                    <ul>
                      <li><strong>northwindgoods.com</strong> is the primary domain with SSL active.</li>
                      <li><strong>support@northwindgoods.com</strong> is live and verified; your personal address appears <strong>0</strong> times on the site.</li>
                    </ul>
                    <span class="msg-time">10:42 AM</span>
                  </div>
                </div>

                <div class="composer-stack">
                  <div class="comp-cwd">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" aria-hidden="true"><path d="M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z"/></svg>
                    <span>~/sites/northwind (main)</span>
                  </div>

                  <div class="win-composer">
                    <div class="comp-input">Message Meridian…</div>
                    <div class="comp-bar">
                      <div class="comp-left">
                        <span class="comp-ico" aria-hidden="true">+</span>
                        <span class="comp-model-pill">qwen3-coder · local ▾</span>
                      </div>
                      <div class="comp-right">
                        <span class="comp-wave" aria-hidden="true">
                          <i></i><i></i><i></i><i></i>
                        </span>
                        <span class="comp-send" aria-hidden="true">↑</span>
                      </div>
                    </div>
                  </div>

                  <div class="composer-foot">
                    <span>Accept edits ▾</span>
                    <span>Enter to send · 20% context</span>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 1c. UNDER THE HOOD: technical audience only (GitHub, HN, ?for=technical) -->
  <section class="band spec-band" id="under-the-hood" data-aud="technical" aria-label="Technical details">
    <div class="container wrap">
      <div class="band-head">
        <h2>Under the hood.</h2>
        <p>What runs where, and what leaves your machine.</p>
      </div>
      <dl class="spec-grid">
        <div><dt>Runtime</dt><dd><a href="https://github.com/letta-ai/letta-code" target="_blank" rel="noreferrer">letta-code</a> on your host, wrapped by the Baken host service for pairing and transport.</dd></div>
        <div><dt>Memory</dt><dd>Plain text files on the host's disk, readable and editable, safe to version with git or back up.</dd></div>
        <div><dt>Transport</dt><dd>Iroh QUIC, end to end encrypted and mutually authenticated. Direct when possible; the fallback relay can't read traffic.</dd></div>
        <div><dt>Pairing</dt><dd>QR invite from the host. No public port, reverse proxy or copied API token.</dd></div>
        <div><dt>Models</dt><dd>Any provider letta-code supports, or local inference. Swap at any time; memory stays.</dd></div>
        <div><dt>Tools</dt><dd>MCP servers plus the host's files, terminal and browser, under four permission modes: standard, accept edits, strict, unrestricted.</dd></div>
        <div><dt>Clients</dt><dd>Android 8.0+, Windows x64, Linux x64 AppImage. Kotlin Multiplatform with Compose.</dd></div>
        <div><dt>Host wrapper</dt><dd>JVM 21+, released for Linux x64, runs as a service.</dd></div>
        <div><dt>Telemetry</dt><dd>None in release builds. No account, no Baken server.</dd></div>
        <div><dt>Licence</dt><dd>Source available on GitHub. <a href="/licenses">Details</a>.</dd></div>
      </dl>
      <div class="spec-cta">
        <a class="btn btn-primary" href={LINKS.appRepo} target="_blank" rel="noreferrer" data-umami-event="github-spec">View the source</a>
        <a class="btn btn-outline" href="/docs">Read the docs</a>
      </div>
    </div>
  </section>

  <!-- 2. BENTO CAPABILITY GRID (x.ai/bot style: each card is a concrete behavior + live mini-UI artifact) -->
  <section class="band screens-2" id="capabilities">
    <div class="container wrap">
      <div class="band-head">
        <h2>What a Baken agent does.</h2>
        <p>Each example below is taken from the app. The agent, its memory and its tools are the same on every device.</p>
      </div>

      <div class="bento-grid">
        <!-- Card 1: Remembers what you teach it -->
        <article class="bento-card" data-tone="indigo">
          <div class="bento-art" style="--art:url('/art/cards/memory.png')" role="img" aria-label="Sea chart west of Ireland, 1658"></div>
          <div class="bento-copy">
            <h3>Memory as plain files.</h3>
            <p>The agent's memory is a set of plain text files on your host. When you state a preference or a rule, it writes it there and applies it in later sessions. You can open and edit those files directly.</p>
          </div>
          <div class="bento-ui dark-surface">
            <div class="ui-msg-u">Never put my personal Gmail on any public store page.</div>
            <div class="ui-memory-toast">
              <div class="mem-head">
                <span class="mem-dot"></span>
                <strong>Saved to memory</strong>
                <span class="mem-file">projects/shop.md</span>
              </div>
              <p>Keep personal email off all public storefronts and policies; always use the domain support@ address.</p>
            </div>
          </div>
        </article>

        <!-- Card 6: Phone + Desktop paired directly -->
        <article class="bento-card" data-tone="vermilion">
          <div class="bento-art" style="--art:url('/art/cards/pairing.png')" role="img" aria-label="Anglers by a windmill and a baken, Jan van de Velde II, 1627"></div>
          <div class="bento-copy">
            <h3>Direct phone pairing.</h3>
            <p>Pair your phone by scanning a QR code. The connection is encrypted end to end and goes direct when it can. When a direct path fails it falls back to a relay, which cannot read the traffic. We run no Baken server.</p>
          </div>
          <div class="bento-ui dark-surface">
            <div class="ui-pair-box">
              <RiveBakenMark size={44} state="connecting" theme="dark" title="Baken connecting state — click to peer-lock" />
              <div class="pair-text">
                <strong>Your phone ⇄ Home computer</strong>
                <span>End-to-end encrypted · direct when possible</span>
              </div>
            </div>
          </div>
        </article>

        <!-- Card 2: Every agent has its own computer (yours) -->
        <article class="bento-card" data-tone="ochre">
          <div class="bento-art" style="--art:url('/art/cards/permissions.png')" role="img" aria-label="Compass, Isaac Weissenbruch, 1836"></div>
          <div class="bento-copy">
            <h3>Four permission modes.</h3>
            <p>Agents use the host's files, terminal, browser and local apps. Each session runs in one of four permission modes: standard, accept edits, strict, or unrestricted.</p>
          </div>
          <div class="bento-ui dark-surface">
            <div class="ui-term-head">
              <span>Computer · You're in control</span>
              <span class="ui-badge-live">● Working</span>
            </div>
            <div class="ui-diff">
              <div class="diff-file">wrangler.jsonc</div>
              <div class="diff-del">- "pattern": "staging.baken.ca"</div>
              <div class="diff-add">+ "pattern": "baken.ca", "custom_domain": true</div>
            </div>
            <div class="ui-approve-bar">
              <span>Deployed to baken.ca · HTTP 200 verified</span>
              <span class="ui-ok">✓ Done</span>
            </div>
          </div>
        </article>

        <!-- Card 3: Keeps working when you walk away (Fork & Relay) -->
        <article class="bento-card" data-tone="verdigris">
          <div class="bento-art" style="--art:url('/art/cards/background.png')" role="img" aria-label="Dunes with a lighthouse, after Coenraet Decker, c.1685"></div>
          <div class="bento-copy">
            <h3>Background tasks.</h3>
            <p>Long tasks run in the background on the host, so the conversation stays usable. Running tasks show on both your phone and desktop.</p>
          </div>
          <div class="bento-ui dark-surface">
            <div class="ui-run-row">
              <RiveBakenMark size={30} state="loading" theme="dark" title="Baken loading state" />
              <div class="run-meta">
                <strong>Scanning 45 repositories for leaked keys…</strong>
                <span>Background worker · 3m elapsed · chat stays unlocked</span>
              </div>
            </div>
            <div class="ui-relay">
              <strong>Meridian</strong> · just now<br />
              <span>Finished the scan in the background — found 2 old tokens, revoked both, and verified they return 401.</span>
            </div>
          </div>
        </article>

        <!-- Card 4: Agents work with each other -->
        <article class="bento-card" data-tone="indigo">
          <div class="bento-art" style="--art:url('/art/cards/handoff.png')" role="img" aria-label="Harbour with a lighthouse, Reinier Zeeman, 1656"></div>
          <div class="bento-copy">
            <h3>Agent handoff.</h3>
            <p>Agents on the same host can pass tasks to each other, for example from a general agent to a coding agent. Each handoff appears in the conversation.</p>
          </div>
          <div class="bento-ui dark-surface">
            <div class="ui-handoff">
              <div class="ho-row">
                <span class="ho-dot blue"></span>
                <div><strong class="ho-name blue">Meridian</strong> → <strong class="ho-name orange">Builder</strong><p>Handing over the app icon update with the new artwork attached.</p></div>
              </div>
              <div class="ho-row">
                <span class="ho-dot orange"></span>
                <div><strong class="ho-name orange">Builder</strong><p>Swapped in the new icon. Running the checks now.</p></div>
              </div>
            </div>
          </div>
        </article>

        <!-- Card 5: Hands-free voice -->
        <article class="bento-card" data-tone="verdigris">
          <div class="bento-art" style="--art:url('/art/cards/voice.png')" role="img" aria-label="River landscape with a baken, H. J. H. Rijkelijkhuizen, 1857"></div>
          <div class="bento-copy">
            <h3>Voice mode.</h3>
            <p>Voice mode works on phone and desktop. Speech recognition runs on a speech server you configure on the host, and each agent can have its own voice.</p>
          </div>
          <div class="bento-ui dark-surface">
            <div class="ui-voice-box">
              <RiveMascot size={62} shape="blob" color="#1E7BF0" state="speaking" talk={true} title="Meridian speaking" />
              <div class="v-bars" aria-hidden="true">
                <span style="--h:36%"></span><span style="--h:82%"></span><span style="--h:54%"></span>
                <span style="--h:95%"></span><span style="--h:60%"></span><span style="--h:78%"></span>
                <span style="--h:40%"></span>
              </div>
              <span class="v-live">Speaking · 0:14</span>
            </div>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- 3. GIVE EACH AGENT A JOB (Interactive Role Switcher — x.ai/bot's signature section adapted to Baken) -->
  <section class="band band-rule band-tinted art-band" id="jobs" style="--band-art:url('/art/jobs.png'); --band-tone:var(--tone-verdigris)">
    <div class="band-art" role="img" aria-label="Background: Strand met vissers (beach with fishermen), Carel Frederik Curtenius Bentinck, 1824"></div>
    <div class="container wrap">
      <div class="band-head">
        <h2>One person's setup.</h2>
        <p>These are real examples from the developer who builds Baken. Each agent is a general agent given access to specific tools on his host. Baken doesn't ship these as features; they show what one agent with memory and tool access can be set up to do.</p>
      </div>

      <div class="jobs-pills" id="jobPills" role="tablist" aria-label="Agent roles">
        <button type="button" class="job-pill active" data-job="companion" role="tab" aria-selected="true">Daily Companion</button>
        <button type="button" class="job-pill" data-job="coding" role="tab" aria-selected="false">Code &amp; PRs</button>
        <button type="button" class="job-pill" data-job="homelab" role="tab" aria-selected="false">Home &amp; Media</button>
        <button type="button" class="job-pill" data-job="store" role="tab" aria-selected="false">Store &amp; Ops</button>
        <button type="button" class="job-pill" data-job="finances" role="tab" aria-selected="false">Finances &amp; Admin</button>
        <button type="button" class="job-pill" data-job="research" role="tab" aria-selected="false">Deep Research</button>
      </div>

      <div class="job-stage dark-surface" id="jobStage" data-active-job="companion">
        <!-- Job 1: Daily Companion -->
        <div class="job-panel active" data-panel="companion">
          <div class="job-desc">
            <h3>A general companion agent.</h3>
            <p>Over months, the agent builds up context about your projects, your schedule and how you like to work. That memory stays on your machine and carries across every device.</p>
            <ul>
              <li>Picks up threads you paused weeks ago without re-explaining</li>
              <li>Reaches you across desktop, phone, voice, or chat rooms</li>
              <li>Stays honest when a plan won't work</li>
            </ul>
          </div>
          <div class="job-chat">
            <div class="jc-u">Did we ever fix that slow search on the media box?</div>
            <div class="jc-a">Yes — a couple of weeks ago we cut out the slow middle step between your search sources. Searches got about twice as fast.</div>
          </div>
        </div>

        <!-- Job 2: Code & PRs -->
        <div class="job-panel" data-panel="coding">
          <div class="job-desc">
