  @media (max-width: 900px) {
    .why-chart-bg {
      -webkit-mask-image: url('/art/waghenaer-vlie-marsdiep-1583.png'), url('/art/dither-ramp-y.png');
              mask-image: url('/art/waghenaer-vlie-marsdiep-1583.png'), url('/art/dither-ramp-y.png');
      -webkit-mask-size: 2320px auto, 32px 100%;
