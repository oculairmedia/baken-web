---
import Layout from '../layouts/Layout.astro';
import BakenMark from '../components/BakenMark.astro';
import { LINKS, MASCOT_BODIES, GLYPHS } from '../lib/brand';
---

<Layout
  title="Baken — The power of your desktop agents, in your pocket"
  description="Baken pairs Android, Windows, and Linux directly with your own agent host. Chat, talk hands-free, and keep your agents, memory, and tools on hardware you own. No account, end-to-end encrypted."
>
  <!-- HERO -->
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <span class="pill">
          <span class="pill-dot"></span>
          Open source · Free · Public beta
        </span>
        <h1>The power of your desktop, in your pocket.</h1>
        <p class="lead">
          Baken pairs your phone and desktop directly with the agents running on your own machine. Chat, talk hands-free, and watch tools work in real time. The models, memory, and tools stay on hardware you control.
        </p>
        <div class="hero-ctas">
          <a class="btn btn-primary btn-lg" href={LINKS.releases} target="_blank" rel="noreferrer" data-umami-event="download-hero">
            Download latest release
          </a>
          <a class="btn btn-lg" href="#pair" data-umami-event="pair-hero">
            How pairing works
          </a>
        </div>
        <div class="trust-chips mono" aria-label="Key highlights">
          <span>No account</span>
          <span>Android, Windows &amp; Linux</span>
          <span>Direct P2P</span>
          <span>End-to-end encrypted</span>
        </div>
      </div>

      <!-- INTERACTIVE LIVING STAGE -->
      <div class="stage-card">
        <div class="stage-top">
          <span class="mono stage-status" id="stageStatus">baken = idle · meridian = idle</span>
          <button type="button" class="mini-btn" id="btnLockDemo" style="display:none">Lock peer →</button>
        </div>

        <div class="stage-canvas" id="heroStage" data-state="idle">
          <div class="mascot-wrap" title="Meridian">
            <svg width="84" height="84" viewBox="-190 -190 380 380" aria-hidden="true">
              <path d={MASCOT_BODIES.blob} fill="#1E7BF0" />
              <g transform="rotate(-8)">
                <rect x="-56" y="-56" width="112" height="112" rx="26" fill="#F7F7F7" />
                <g class="m-gaze"><g class="eye-blink" data-role="glyph" set:html={GLYPHS.idle} /></g>
              </g>
            </svg>
          </div>

          <BakenMark uid="hero" size={146} state="idle" class="hero-baken" />

          <div class="mascot-stack">
            <div class="mascot-wrap" style="animation-delay:-1.3s" title="Worker">
              <svg width="60" height="60" viewBox="-190 -190 380 380" aria-hidden="true">
                <path d={MASCOT_BODIES.triangle} fill="#FF6A1A" />
                <g transform="translate(0,12) rotate(7)">
                  <rect x="-50" y="-50" width="100" height="100" rx="24" fill="#F7F7F7" />
                  <g class="m-gaze"><g class="eye-blink" data-role="glyph" set:html={GLYPHS.idle} /></g>
                </g>
              </svg>
            </div>
            <div class="mascot-wrap" style="animation-delay:-2.5s" title="PM">
              <svg width="60" height="60" viewBox="-190 -190 380 380" aria-hidden="true">
                <path d={MASCOT_BODIES.squircle} fill="#1DA34A" />
                <g transform="rotate(-5)">
                  <rect x="-54" y="-54" width="108" height="108" rx="25" fill="#F7F7F7" />
                  <g class="m-gaze"><g class="eye-blink" data-role="glyph" set:html={GLYPHS.idle} /></g>
                </g>
              </svg>
            </div>
          </div>
        </div>

        <div class="stage-controls" id="stateControls">
          <div class="ctrl-row">
            <span class="ctrl-label mono">App state</span>
            <button type="button" class="chip active" data-app="idle">idle</button>
            <button type="button" class="chip" data-app="boot">boot</button>
            <button type="button" class="chip" data-app="loading">loading</button>
            <button type="button" class="chip" data-app="connecting">connecting</button>
            <button type="button" class="chip" data-app="ambient">ambient</button>
            <button type="button" class="chip" data-app="degraded">degraded</button>
          </div>
          <div class="ctrl-row">
            <span class="ctrl-label mono">Agent turn</span>
            <button type="button" class="chip secondary" id="btnMascotTurn">mascot: idle</button>
            <span class="ctrl-note">Baken owns connection &amp; harbour state · Mascots own turn activity</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 3-STEP PAIRING FLOW (modeled on Osaurus "Paired in a minute") -->
  <section class="section" id="pair">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow mono">SETUP</span>
        <h2>Paired in a minute.</h2>
        <p class="section-sub">
          Baken is a companion to the agents running on your own computer or home server. There is no account and no hosted cloud in the middle — your devices talk to your host directly.
        </p>
      </div>

      <div class="steps-grid">
        <article class="step-card">
          <span class="step-num mono">1</span>
          <h3>Run your agent host.</h3>
          <p>Start the host runtime and Iroh wrapper on your Linux server or desktop, with your agents, memory, and models already in place.</p>
          <div class="need-box">
            <span class="need-label mono">You need</span>
            <ul>
              <li>Linux host (or workstation) running your agent backend</li>
              <li>At least one agent with a local or cloud model</li>
            </ul>
          </div>
        </article>

        <article class="step-card">
          <span class="step-num mono">2</span>
          <h3>Install Baken on Android or Desktop.</h3>
          <p>Grab the latest Android APK, Windows installer, or Linux AppImage straight from GitHub Releases — free, no sign-up.</p>
          <div class="need-box">
            <span class="need-label mono">You need</span>
            <ul>
              <li>Android 8.0 or later, Windows 10/11 (x64), or Linux (x64)</li>
              <li>Latest build from GitHub Releases</li>
            </ul>
          </div>
          <a class="step-link" href={LINKS.releases} target="_blank" rel="noreferrer" data-umami-event="download-step2">
            Open latest release →
          </a>
        </article>

        <article class="step-card">
          <span class="step-num mono">3</span>
          <h3>Scan the QR code.</h3>
          <p>Generate a pairing invite from the CLI or desktop host and scan it on your phone. Mutual keys are exchanged automatically — no hand-pasted tokens or port forwarding.</p>
          <div class="need-box">
            <span class="need-label mono">You need</span>
            <ul>
              <li>One QR scan to bind your device key</li>
              <li>Works on LAN or over the internet via encrypted Iroh QUIC</li>
            </ul>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- CORE CAPABILITIES ("Your computer does the work. Your phone goes with you.") -->
  <section class="section" id="architecture">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow mono">THE EXPERIENCE</span>
        <h2>Your machine does the work. Your phone goes with you.</h2>
        <p class="section-sub">
          Everything you set up on your host is ready on every screen: your agents, their models, their memory, and their tools.
        </p>
      </div>

      <div class="feature-rows">
        <!-- Row 1: Voice -->
        <div class="feature-card">
          <div class="feature-copy">
            <span class="eyebrow mono">VOICE</span>
            <h3>Talk to an agent, hands-free.</h3>
            <p>
              Speak naturally on Android or Desktop using built-in platform speech or your own self-hosted OpenAI-compatible voice server (Whisper, Kokoro, or any local GPU endpoint).
            </p>
            <ul class="check-list">
              <li>Streaming sentence-by-sentence speech replies</li>
              <li>Single-shot or continuous hands-free conversation mode</li>
              <li>Works with both local and cloud models</li>
            </ul>
          </div>
          <div class="feature-visual">
            <div class="voice-demo">
              <div class="voice-row">
                <BakenMark uid="v-mark" size={32} state="idle" />
                <div class="voice-meta">
                  <strong>Meridian · Voice</strong>
                  <span class="mono">local endpoint · streaming</span>
                </div>
                <span class="live-pill mono">LISTENING</span>
              </div>
              <div class="voice-bars" aria-hidden="true">
                <span style="--h:36%"></span><span style="--h:78%"></span><span style="--h:54%"></span>
                <span style="--h:92%"></span><span style="--h:64%"></span><span style="--h:42%"></span>
                <span style="--h:84%"></span><span style="--h:50%"></span><span style="--h:30%"></span>
              </div>
              <div class="voice-caption">“Check what finished building while I was away.”</div>
            </div>
          </div>
        </div>

        <!-- Row 2: Coexistence & Motion -->
        <div class="feature-card" id="presence">
          <div class="feature-visual">
            <div class="rail-frame">
              <div class="rail-col">
                <div class="rail-slot app-slot" id="railMarkSlot">
                  <BakenMark uid="rail" size={26} state="idle" />
                </div>
                <div class="rail-div"></div>
                <div class="rail-slot active-agent">
                  <svg width="32" height="32" viewBox="-185 -185 370 370" aria-hidden="true">
                    <path d={MASCOT_BODIES.blob} fill="#1E7BF0" />
                    <rect x="-66" y="-66" width="132" height="132" rx="30" fill="#F7F7F7" transform="rotate(-8)" />
                    <g class="m-gaze"><g class="eye-blink" set:html={GLYPHS.idle} /></g>
                  </svg>
                </div>
                <div class="rail-slot">
                  <svg width="32" height="32" viewBox="-185 -185 370 370" aria-hidden="true">
                    <path d={MASCOT_BODIES.triangle} fill="#FF6A1A" />
                    <rect x="-58" y="-44" width="116" height="116" rx="28" fill="#F7F7F7" />
                    <g class="m-gaze" transform="translate(0,14)"><g class="eye-blink" set:html={GLYPHS.idle} /></g>
                  </svg>
                </div>
                <div class="rail-slot">
                  <svg width="32" height="32" viewBox="-185 -185 370 370" aria-hidden="true">
                    <path d={MASCOT_BODIES.squircle} fill="#1DA34A" />
                    <rect x="-66" y="-66" width="132" height="132" rx="30" fill="#F7F7F7" transform="rotate(4)" />
                    <g class="m-gaze"><g class="eye-blink" set:html={GLYPHS.idle} /></g>
                  </svg>
                </div>
                <div class="rail-slot">
                  <svg width="32" height="32" viewBox="-185 -185 370 370" aria-hidden="true">
                    <path d={MASCOT_BODIES.circle} fill="#E5484D" />
                    <rect x="-66" y="-66" width="132" height="132" rx="30" fill="#F7F7F7" transform="rotate(-5)" />
                    <g class="m-gaze"><g class="eye-blink" set:html={GLYPHS.idle} /></g>
                  </svg>
                </div>
              </div>

              <div class="rail-body">
                <div class="rail-header">
                  <strong>Meridian</strong>
                  <span class="mono badge">Iroh · connected</span>
                </div>
                <div class="rail-item">
                  <BakenMark uid="load-demo" size={26} state="loading" />
                  <div>
                    <div class="item-t">Grounded stone-cradle loaders</div>
                    <div class="item-s">Weighted basalt motion — no generic spinners.</div>
                  </div>
                </div>
                <div class="rail-item">
                  <BakenMark uid="conn-demo" size={26} state="connecting" />
                  <div>
                    <div class="item-t">Channel-seam reconnect</div>
                    <div class="item-s">Stones part while seeking a peer and seat on lock.</div>
                  </div>
                </div>
                <div class="rail-toast">
                  <BakenMark uid="amb-demo" size={22} state="ambient" />
                  <span>Ambient harbour glow — quiet updates without stealing focus.</span>
                </div>
              </div>
            </div>
          </div>
          <div class="feature-copy">
            <span class="eyebrow mono">LIVING PRESENCE</span>
            <h3>The harbour stays calm so your agents can speak.</h3>
            <p>
              Nothing in Baken is static, and nothing competes for attention. The grounded basalt mark owns app and connection state; your chosen Rive mascots below it own every agent turn, tool call, and expression.
            </p>
            <ul class="check-list">
              <li>Pick a shape, color, and angle for every agent</li>
              <li>Unified Rive state machine across Android and Desktop</li>
              <li>Honors system <code>reduceMotion</code> everywhere</li>
            </ul>
          </div>
        </div>

        <!-- Row 3: Desktop + Android continuity -->
        <div class="feature-card">
          <div class="feature-copy">
            <span class="eyebrow mono">ANDROID &amp; DESKTOP</span>
            <h3>Made for pockets and wide screens alike.</h3>
            <p>
              Start a conversation on your desktop with a full agent rail, memory inspector, and live tool cards — then step away and pick up the exact same turn on your phone without losing a single message.
            </p>
            <ul class="check-list">
              <li>Agent rail, pinned threads, and search on Desktop</li>
              <li>Fast, native Android Compose UI built for daily use</li>
              <li>Same agents, same memory, synced live over Iroh</li>
            </ul>
          </div>
          <div class="feature-visual">
            <div class="surfaces-demo">
              <div class="surf-box">
                <span class="mono surf-tag">ANDROID 8.0+</span>
                <strong>Pocket companion</strong>
                <p>Voice, QR pairing, live tool activity, and inline image/artifact viewing on the go.</p>
              </div>
              <div class="surf-box">
                <span class="mono surf-tag">WINDOWS · LINUX</span>
                <strong>Full workspace</strong>
                <p>Multi-agent sidebar, memory &amp; skills views, schedules, and keyboard-first flow.</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- WHAT SHIPS TODAY -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow mono">IN THE BETA TODAY</span>
        <h2>What ships in the beta.</h2>
        <p class="section-sub">
          Every agent you set up on your host is ready on your phone and desktop, with nothing to configure twice.
        </p>
      </div>
      <div class="quad-grid">
        <article class="quad-card">
          <h3>Every agent from your host.</h3>
          <p>Pick an agent and watch the reply stream in with each tool it used. Switch agents from the rail without leaving your flow. Same agent, same memory.</p>
        </article>
        <article class="quad-card">
          <h3>Open what agents share.</h3>
          <p>Images, diffs, tool outputs, and structured A2UI cards render right inside the timeline instead of dumping raw JSON at you.</p>
        </article>
        <article class="quad-card">
          <h3>Replies keep going.</h3>
          <p>Lock your phone or switch apps mid-turn. Your host keeps working, and the finished reply and artifacts are waiting when you come back.</p>
        </article>
        <article class="quad-card">
          <h3>Any model your agent uses.</h3>
          <p>Local GPU models or any cloud provider you choose — Baken uses whatever model the agent runs on your host. Change it there, and every screen follows.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- PRIVATE BY DEFAULT -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow mono">OWN YOUR AI</span>
        <h2>Private by default.</h2>
        <p class="section-sub">
          The models change. Everything else — your chats, your memory, your tools, and your keys — stays yours on your own hardware.
        </p>
      </div>
      <div class="quad-grid">
        <article class="quad-card">
          <h3>End-to-end encrypted.</h3>
          <p>QR pairing sets up peer keys that only your device and your host know. Every message and tool frame travels encrypted over Iroh QUIC, even on your own LAN.</p>
        </article>
        <article class="quad-card">
          <h3>Nothing runs in our cloud.</h3>
          <p>Local models answer from your own machine. A cloud model is only contacted if you explicitly configured that provider on your host.</p>
        </article>
        <article class="quad-card">
          <h3>No account.</h3>
          <p>Install, scan the pairing QR, and start. There is no Baken login, no subscription wall, and nothing to sign up for.</p>
        </article>
        <article class="quad-card">
          <h3>Open source &amp; open standards.</h3>
          <p>Git-tracked agent memory, MCP tools, A2UI surfaces, and open-source client code — inspectable and portable, with zero vendor lock-in.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section" id="faq">
    <div class="container faq-wrap">
      <div class="section-head">
        <span class="eyebrow mono">FAQ</span>
        <h2>Still have questions?</h2>
      </div>
      <div class="faq-list">
        <details open>
          <summary>Is Baken free?</summary>
          <p>Yes. Baken is free and open source on Android, Windows, and Linux. You only pay a cloud model provider if you choose to connect one on your own host.</p>
        </details>
        <details>
          <summary>Do I need my own computer or server?</summary>
          <p>Yes. Baken pairs with an agent host running on hardware you control (a Linux server, homelab box, or desktop). Your agents, memory, and tools live there, and your phone and desktop clients talk to it directly.</p>
        </details>
        <details>
          <summary>What platforms does Baken run on?</summary>
          <p>Android 8.0+ (APK), Windows x64 (`.exe` / `.msi`), and Linux x64 (AppImage), paired with the Linux Iroh host wrapper. All current builds publish together on GitHub Releases.</p>
        </details>
        <details>
          <summary>Do models run on my phone?</summary>
          <p>Your host handles the heavy model inference, so your phone gets full access to whatever local GPU or cloud models your host can run. On-device speech recognition can run directly on the phone.</p>
        </details>
        <details>
          <summary>Is the connection secure?</summary>
          <p>Yes. Scanning the pairing QR negotiates device keys shared only between your client and your host, and traffic is end-to-end encrypted over Iroh QUIC.</p>
        </details>
        <details>
          <summary>What happens to my memory if I switch models?</summary>
          <p>Nothing is lost. Your agents' memory lives in plain git-tracked markdown files on your own host, completely decoupled from any single model provider.</p>
        </details>
        <details>
          <summary>It's in public beta — what should I expect?</summary>
          <p>Fast iteration and regular GitHub releases. Expect rough edges as the Meridian → Baken rename finishes rolling through the release artifacts, and file issues directly on GitHub when something breaks.</p>
        </details>
      </div>
    </div>
  </section>

  <!-- BOTTOM CTA -->
  <section class="section">
    <div class="container">
      <div class="cta-band">
        <div style="display:flex;align-items:center;gap:20px;flex-wrap:wrap">
          <img src="/brand/baken-app-icon-lit.svg" alt="Baken app icon" width="76" height="76" class="cta-icon" />
          <div>
            <h2>Own your AI. On every screen.</h2>
            <p class="cta-sub">Free and open source. No account, no subscription. Pair with your own host in a minute.</p>
          </div>
        </div>
        <div class="hero-ctas" style="margin:0">
          <a class="btn btn-primary btn-lg" href={LINKS.releases} target="_blank" rel="noreferrer" data-umami-event="download-footer">
            Download latest release
          </a>
          <a class="btn btn-lg" href={LINKS.appRepo} target="_blank" rel="noreferrer">
            GitHub
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .hero { padding: 64px 0 40px; }
  .hero-grid { display: grid; grid-template-columns: 1.05fr 1fr; gap: 44px; align-items: center; }
  .hero-copy h1 { margin: 18px 0 18px; font-size: clamp(38px, 4.9vw, 58px); line-height: 1.06; letter-spacing: -0.04em; font-weight: 700; }
  .lead { margin: 0 0 26px; font-size: 17px; color: var(--muted); max-width: 52ch; }
  .hero-ctas { display: flex; flex-wrap: wrap; gap: 12px; margin-bottom: 18px; }
  .trust-chips { display: flex; flex-wrap: wrap; gap: 8px 16px; font-size: 12px; color: var(--muted); }
  .trust-chips span::before { content: "· "; color: var(--stone-2); font-weight: 700; }
  .trust-chips span:first-child::before { content: ""; }

  .stage-card { background: var(--surface); border: 1px solid var(--border); border-radius: 26px; padding: 18px; }
  .stage-top { display: flex; align-items: center; justify-content: space-between; min-height: 30px; margin-bottom: 10px; }
  .stage-status { font-size: 11px; color: var(--muted); background: var(--bg); border: 1px solid var(--border); padding: 4px 10px; border-radius: 999px; }
  .mini-btn { border: none; border-radius: 999px; background: var(--stone-2); color: #fff; font-family: inherit; font-size: 12px; font-weight: 700; padding: 5px 12px; cursor: pointer; }
  .stage-canvas { height: 252px; border-radius: 18px; background: var(--bg); border: 1px solid var(--border); display: flex; align-items: center; justify-content: center; gap: 24px; }
  .mascot-stack { display: flex; flex-direction: column; gap: 10px; }
  .stage-controls { margin-top: 14px; display: flex; flex-direction: column; gap: 8px; }
  .ctrl-row { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; }
  .ctrl-label { font-size: 11px; color: var(--muted); margin-right: 4px; }
  .ctrl-note { font-size: 11px; color: var(--muted); margin-left: 4px; }
  .chip { font-family: inherit; font-size: 12px; font-weight: 500; padding: 5px 11px; border-radius: 999px; border: 1px solid var(--border); background: var(--bg); color: var(--text); cursor: pointer; transition: all 160ms ease; }
  .chip:hover { border-color: var(--stone-2); }
  .chip.active { background: var(--stone-2); border-color: var(--stone-2); color: #fff; }
  .chip.secondary.active { background: var(--stone-1); border-color: var(--stone-1); color: var(--bg); }

  .section { padding: 54px 0; }
  .section-head { margin-bottom: 28px; max-width: 68ch; }
  .eyebrow { display: block; font-size: 12px; letter-spacing: 0.08em; color: var(--stone-2); margin-bottom: 10px; }
  .section-head h2, .cta-band h2 { margin: 0; font-size: clamp(28px, 3.4vw, 40px); letter-spacing: -0.035em; line-height: 1.12; }
  .section-sub { margin: 12px 0 0; font-size: 16px; color: var(--muted); }

  /* 3-step pairing cards */
  .steps-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; }
  .step-card { background: var(--surface); border: 1px solid var(--border); border-radius: 24px; padding: 24px; display: flex; flex-direction: column; }
  .step-num { display: inline-grid; place-items: center; width: 30px; height: 30px; border-radius: 999px; background: var(--stone-2); color: #fff; font-size: 13px; font-weight: 700; margin-bottom: 14px; }
  .step-card h3 { margin: 0 0 8px; font-size: 18px; letter-spacing: -0.02em; }
  .step-card > p { margin: 0 0 18px; font-size: 14.5px; color: var(--muted); }
  .need-box { margin-top: auto; padding: 14px 16px; border-radius: 14px; background: var(--bg); border: 1px solid var(--border); }
  .need-label { display: block; font-size: 11px; text-transform: uppercase; letter-spacing: 0.06em; color: var(--muted); margin-bottom: 8px; }
  .need-box ul { margin: 0; padding-left: 16px; color: var(--text); font-size: 13px; display: flex; flex-direction: column; gap: 5px; }
  .step-link { margin-top: 14px; font-size: 13.5px; font-weight: 700; color: var(--stone-2); }
  .step-link:hover { text-decoration: underline; }

  /* Feature spotlight rows */
  .feature-rows { display: flex; flex-direction: column; gap: 22px; }
  .feature-card { background: var(--surface); border: 1px solid var(--border); border-radius: 26px; padding: 32px; display: grid; grid-template-columns: 1fr 1.05fr; gap: 36px; align-items: center; }
  .feature-copy h3 { margin: 0 0 12px; font-size: clamp(22px, 2.5vw, 28px); letter-spacing: -0.025em; line-height: 1.18; }
  .feature-copy p { margin: 0 0 16px; color: var(--muted); font-size: 15px; }
  .check-list { margin: 0; padding-left: 18px; display: flex; flex-direction: column; gap: 8px; font-size: 14px; color: var(--text); }
  .check-list code { font-size: 12.5px; background: var(--bg); border: 1px solid var(--border); padding: 1px 6px; border-radius: 6px; }

  .voice-demo { background: var(--bg); border: 1px solid var(--border); border-radius: 20px; padding: 22px; display: flex; flex-direction: column; gap: 20px; }
  .voice-row { display: flex; align-items: center; gap: 12px; }
  .voice-meta { display: flex; flex-direction: column; font-size: 14px; }
  .voice-meta span { font-size: 11px; color: var(--muted); }
  .live-pill { margin-left: auto; font-size: 11px; padding: 4px 10px; border-radius: 999px; background: rgba(238,90,63,0.16); color: var(--stone-2); border: 1px solid rgba(238,90,63,0.4); }
  .voice-bars { height: 64px; display: flex; align-items: center; justify-content: center; gap: 8px; }
  .voice-bars span { width: 7px; height: var(--h); border-radius: 999px; background: var(--stone-2); opacity: 0.85; animation: vbar 1.4s ease-in-out infinite; }
  .voice-bars span:nth-child(even) { background: var(--stone-1); animation-delay: -0.5s; }
  @keyframes vbar { 0%, 100% { transform: scaleY(0.55); } 50% { transform: scaleY(1.1); } }
  .voice-caption { font-size: 14px; color: var(--muted); text-align: center; font-style: italic; }

  .surfaces-demo { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
  .surf-box { background: var(--bg); border: 1px solid var(--border); border-radius: 18px; padding: 20px; display: flex; flex-direction: column; gap: 8px; }
  .surf-tag { font-size: 11px; color: var(--stone-2); letter-spacing: 0.06em; }
  .surf-box strong { font-size: 16px; }
  .surf-box p { margin: 0; font-size: 13.5px; color: var(--muted); }

  /* Rail showcase */
  .rail-frame { display: flex; background: var(--bg-deep); border: 1px solid var(--border); border-radius: 20px; overflow: hidden; min-height: 312px; }
  .rail-col { width: 62px; background: var(--bg-deep); border-right: 1px solid var(--border); display: flex; flex-direction: column; align-items: center; padding: 14px 0; gap: 10px; }
  .rail-div { width: 26px; height: 1px; background: var(--border); }
  .rail-slot { width: 42px; height: 42px; border-radius: 13px; display: grid; place-items: center; }
  .rail-slot.app-slot { background: var(--surface); border: 1px solid var(--border); }
  .rail-slot.active-agent { background: rgba(238, 90, 63, 0.14); box-shadow: inset 0 0 0 1.5px var(--stone-2); }
  .rail-body { flex: 1; background: var(--bg); padding: 16px 18px; display: flex; flex-direction: column; gap: 10px; }
  .rail-header { display: flex; align-items: center; justify-content: space-between; padding-bottom: 10px; border-bottom: 1px solid var(--border); }
  .badge { font-size: 11px; color: var(--muted); background: var(--surface); border: 1px solid var(--border); padding: 3px 9px; border-radius: 999px; }
  .rail-item { display: flex; align-items: center; gap: 12px; padding: 11px 13px; border-radius: 14px; background: var(--surface); border: 1px solid var(--border); }
  .item-t { font-size: 13.5px; font-weight: 700; }
  .item-s { font-size: 12px; color: var(--muted); }
  .rail-toast { margin-top: auto; display: flex; align-items: center; gap: 10px; padding: 9px 13px; border-radius: 999px; background: var(--surface); border: 1px solid var(--border); font-size: 12px; }

  /* 2x2 grids */
  .quad-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 18px; }
  .quad-card { background: var(--surface); border: 1px solid var(--border); border-radius: 22px; padding: 26px; }
  .quad-card h3 { margin: 0 0 10px; font-size: 18px; letter-spacing: -0.02em; }
  .quad-card p { margin: 0; font-size: 14.5px; color: var(--muted); }

  /* FAQ */
  .faq-wrap { max-width: 820px; }
  .faq-list { display: flex; flex-direction: column; gap: 10px; }
  .faq-list details { background: var(--surface); border: 1px solid var(--border); border-radius: 18px; padding: 18px 22px; }
  .faq-list summary { cursor: pointer; font-weight: 700; font-size: 16px; list-style: none; display: flex; align-items: center; justify-content: space-between; gap: 12px; }
  .faq-list summary::-webkit-details-marker { display: none; }
  .faq-list summary::after { content: "+"; color: var(--stone-2); font-size: 20px; line-height: 1; }
  .faq-list details[open] summary::after { content: "−"; }
  .faq-list details p { margin: 12px 0 0; color: var(--muted); font-size: 14.5px; }

  /* CTA Band */
  .cta-band { background: var(--surface); border: 1px solid var(--border); border-radius: 28px; padding: 34px 36px; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 24px; }
  .cta-icon { border-radius: 18px; box-shadow: 0 10px 28px rgba(0, 0, 0, 0.25); }
  .cta-sub { margin: 6px 0 0; color: var(--muted); font-size: 15px; }

  @media (prefers-reduced-motion: reduce) {
    .voice-bars span { animation: none !important; }
  }
  @media (max-width: 960px) {
    .hero-grid, .feature-card { grid-template-columns: 1fr; }
    .steps-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 680px) {
    .quad-grid, .surfaces-demo { grid-template-columns: 1fr; }
    .hero { padding-top: 38px; }
    .feature-card, .cta-band { padding: 22px; }
  }
</style>

<script define:vars={{ GLYPHS }}>
  const heroStage = document.getElementById('heroStage');
  const heroMark = heroStage?.querySelector('.hero-baken');
  const railMark = document.querySelector('#railMarkSlot .baken-mark-host');
  const statusEl = document.getElementById('stageStatus');
  const lockBtn = document.getElementById('btnLockDemo');
  const mascotBtn = document.getElementById('btnMascotTurn');

  let appState = 'idle';
  let mascotState = 'idle';

  function renderStatus() {
    if (statusEl) statusEl.textContent = `baken = ${appState} · meridian = ${mascotState}`;
    if (lockBtn) lockBtn.style.display = appState === 'connecting' ? 'inline-block' : 'none';
  }

  function setAppState(next) {
    appState = next;
    heroMark?.setAttribute('data-state', next);
    railMark?.setAttribute('data-state', next);
    document.querySelectorAll('#stateControls [data-app]').forEach((b) => {
      b.classList.toggle('active', b.getAttribute('data-app') === next);
    });
    renderStatus();
  }

  function setMascotState(next) {
    mascotState = next;
    if (mascotBtn) {
      mascotBtn.textContent = `mascot: ${next}`;
      mascotBtn.classList.toggle('active', next !== 'idle');
    }
    if (next !== 'idle' && appState !== 'idle') setAppState('idle');
    document.querySelectorAll('#heroStage .mascot-wrap').forEach((m) => {
      m.style.animation =
        next === 'thinking'
          ? 'mThink 2.8s ease-in-out infinite'
          : next === 'working'
            ? 'mWork 1.05s ease-in-out infinite'
            : '';
    });
    const glyphKey = next === 'working' ? 'thinking' : next;
    document.querySelectorAll('#heroStage [data-role="glyph"]').forEach((g) => {
      g.innerHTML = GLYPHS[glyphKey] || GLYPHS.idle;
    });
    renderStatus();
  }

  document.getElementById('stateControls')?.addEventListener('click', (e) => {
    const target = e.target;
    if (target instanceof HTMLElement && target.dataset.app) {
      setAppState(target.dataset.app);
    }
  });

  const MASCOT_CYCLE = ['idle', 'thinking', 'working'];
  mascotBtn?.addEventListener('click', () => {
    const idx = (MASCOT_CYCLE.indexOf(mascotState) + 1) % MASCOT_CYCLE.length;
    setMascotState(MASCOT_CYCLE[idx]);
  });

  lockBtn?.addEventListener('click', () => {
    setAppState('success');
    setTimeout(() => setAppState('idle'), 1150);
  });

  const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (!prefersReduced) {
    window.addEventListener('pointermove', (e) => {
      const nx = (e.clientX / window.innerWidth) * 2 - 1;
      const ny = (e.clientY / window.innerHeight) * 2 - 1;
      document.querySelectorAll('.m-gaze').forEach((g) => {
        g.setAttribute('transform', `translate(${(nx * 14).toFixed(1)}, ${(ny * 10).toFixed(1)})`);
      });
    });
  }
</script>
