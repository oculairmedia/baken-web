    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }
  .transit-readout { color: #E2E2E8; }
  .transit-svg { width: 100%; height: auto; display: block; }
  .contour { fill: none; stroke: rgba(255, 255, 255, 0.09); stroke-width: 1; }
  .contour.c2 { stroke-dasharray: 4 4; stroke: rgba(255, 255, 255, 0.13); }
  .contour.c3 { stroke: rgba(255, 255, 255, 0.06); }

  .closing-mark-wrap { display: inline-flex; }
  .closing-h2 { margin: 20px 0 14px; font-size: clamp(34px, 4.5vw, 52px); line-height: 1.06; letter-spacing: -0.04em; }

  @media (prefers-reduced-motion: reduce) { .v-bars span { animation: none !important; } }
  @media (max-width: 900px) {
    .showcase-stage { padding: 20px 18px 0; }
    .win-body { grid-template-columns: 52px 1fr; }
    .win-sidebar, .win-search { display: none; }
