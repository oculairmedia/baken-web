---
import Layout from '../layouts/Layout.astro';
import BakenMark from '../components/BakenMark.astro';
import StringsCanvas from '../components/StringsCanvas.astro';
import { LINKS, MASCOT_BODIES, GLYPHS } from '../lib/brand';
---

<Layout
  title="Baken — An AI companion that stays yours."
  description="An AI companion that remembers your life and your work, lives on your own computer, and stays with you on your phone. It can't be nerfed, sunset, or taken away."
>
  <!-- CENTERED HERO: WHAT IT IS & WHY IT WON'T DISAPPEAR -->
  <section class="hero">
    <div class="container hero-center">
      <a class="eyebrow-pill" href={LINKS.releases} target="_blank" rel="noreferrer">
        Baken Public Beta &nbsp;·&nbsp; Free &amp; Open Source
      </a>

      <h1>An AI companion<br />that stays yours.</h1>

      <p class="hero-lead">
        Most AI apps rent you a forgetful chatbot on someone else's server — one policy change, price hike, or shutdown away from disappearing. Baken lives on your own computer and travels with you on your phone, so the memory you build over months and years is yours to keep.
      </p>

      <div class="hero-cta-row">
        <a class="btn btn-primary" href={LINKS.releases} target="_blank" rel="noreferrer" data-umami-event="download-hero">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 3v12m0 0 4.5-4.5M12 15 7.5 10.5M4 20h16" />
          </svg>
          Download Baken
        </a>
      </div>

      <div class="trust-row" aria-label="What stays in your control">
        <span>No account to get locked out of</span>
        <span>Can't be nerfed or sunset</span>
        <span>Android, Windows &amp; Linux</span>
        <span>Memory stays on your machine</span>
      </div>
    </div>

    <!-- FULL-WIDTH FRAMED PRODUCT SHOWCASE (human outcomes, not protocol names) -->
    <div class="container">
      <div class="showcase-backdrop dark-surface">
        <!-- SCENE 01: REMEMBERS & KEEPS WORKING -->
        <div class="app-window scene active" data-scene="desktop">
          <div class="win-titlebar">
            <div class="win-left">
              <BakenMark uid="win-top" size={18} state="idle" tight />
              <span class="win-tab active-tab">Meridian</span>
              <span class="win-tab">Research</span>
              <span class="win-tab">+</span>
            </div>
            <div class="win-search mono">Search conversations and memory…</div>
            <div class="win-dots" aria-hidden="true">
              <span></span><span></span><span></span>
            </div>
          </div>

          <div class="win-body">
            <aside class="win-rail" aria-label="Companions">
              <div class="rail-icon rail-selected" title="Meridian">
                <svg width="28" height="28" viewBox="-185 -185 370 370" aria-hidden="true">
                  <path d={MASCOT_BODIES.blob} fill="#1E7BF0" />
                  <rect x="-66" y="-66" width="132" height="132" rx="30" fill="#F7F7F7" transform="rotate(-8)" />
                  <g class="m-gaze"><g class="eye-blink" set:html={GLYPHS.idle} /></g>
                </svg>
              </div>
              <div class="rail-icon" title="Builder">
                <svg width="28" height="28" viewBox="-185 -185 370 370" aria-hidden="true">
                  <path d={MASCOT_BODIES.triangle} fill="#FF6A1A" />
                  <rect x="-58" y="-44" width="116" height="116" rx="28" fill="#F7F7F7" />
                  <g class="m-gaze" transform="translate(0,14)"><g class="eye-blink" set:html={GLYPHS.idle} /></g>
                </svg>
              </div>
              <div class="rail-icon" title="Planner">
                <svg width="28" height="28" viewBox="-185 -185 370 370" aria-hidden="true">
                  <path d={MASCOT_BODIES.squircle} fill="#1DA34A" />
                  <rect x="-66" y="-66" width="132" height="132" rx="30" fill="#F7F7F7" transform="rotate(4)" />
                  <g class="m-gaze"><g class="eye-blink" set:html={GLYPHS.idle} /></g>
                </svg>
              </div>
              <div class="rail-icon" title="Archivist">
                <svg width="28" height="28" viewBox="-185 -185 370 370" aria-hidden="true">
                  <path d={MASCOT_BODIES.circle} fill="#E5484D" />
                  <rect x="-66" y="-66" width="132" height="132" rx="30" fill="#F7F7F7" transform="rotate(-5)" />
                  <g class="m-gaze"><g class="eye-blink" set:html={GLYPHS.idle} /></g>
                </svg>
              </div>
            </aside>

            <aside class="win-sidebar">
              <div class="agent-hero">
                <div class="mascot-wrap">
                  <svg width="64" height="64" viewBox="-190 -190 380 380" aria-hidden="true">
                    <path d={MASCOT_BODIES.blob} fill="#1E7BF0" />
                    <g transform="rotate(-8)">
                      <rect x="-56" y="-56" width="112" height="112" rx="26" fill="#F7F7F7" />
                      <g class="m-gaze"><g class="eye-blink" set:html={GLYPHS.idle} /></g>
                    </g>
                  </svg>
                </div>
                <strong>Meridian</strong>
                <span class="mono agent-sub">On your computer</span>
              </div>

              <div class="side-nav">
                <div class="side-item">Memory</div>
                <div class="side-item">Routines</div>
                <div class="side-item">Skills</div>
              </div>

              <div class="side-threads">
                <span class="mono side-label">RECENT</span>
                <div class="thread active-thread">Store launch &amp; domain</div>
                <div class="thread">Living room TV setup</div>
                <div class="thread">Monthly budget check</div>
              </div>
            </aside>

            <div class="win-chat">
              <div class="chat-feed">
                <div class="msg-user">
                  Pick up where we left off on the store — did we ever separate the support email from my personal inbox?
                </div>

                <div class="tool-fold mono">
                  <span class="fold-dot"></span>
                  Checked memory &amp; live policies · 1.2s
                </div>

                <div class="msg-agent">
                  <p>Yes — we finished that on Thursday and I saved it in your project notes:</p>
                  <ul>
                    <li>Your personal address is completely off the storefront and policies.</li>
                    <li><strong>support@</strong> is live on the new domain and verified. Only thing left on your list was ordering a physical print sample before running ads.</li>
                  </ul>
                </div>
              </div>

              <div class="win-composer">
                <span>Keep talking — even while background work is running…</span>
                <div class="comp-right mono">
                  <span>On this computer</span>
                  <span class="comp-mic">●</span>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- SCENE 02: IN YOUR POCKET -->
        <div class="app-window scene" data-scene="pair">
          <div class="pair-stage">
            <div class="pair-panel">
              <span class="mono pair-eyebrow">WITH YOU EVERYWHERE</span>
              <h3>Walk away from your desk. Keep the conversation going.</h3>
              <p>Start a long job on your computer, close your laptop, and check in from your phone. Your phone talks straight to your computer — nothing sits on a company's cloud in between.</p>
              <div class="pair-state-row">
                <BakenMark uid="sc-pair" size={44} state="connecting" />
                <div>
                  <strong>Paired with one scan</strong>
                  <span class="mono">Your phone and your computer, talking directly</span>
                </div>
              </div>
            </div>

            <div class="phone-mock">
              <div class="phone-top mono">
                <span>Meridian</span>
                <span class="phone-ok">● connected home</span>
              </div>
              <div class="phone-msg-u">Look into why the living room TV kept dropping off Wi-Fi while I'm out.</div>
              <div class="phone-tool mono">Finished in the background · 2m ago</div>
              <div class="phone-msg-a">
                Found it — disabling the stock setup app wiped the Wi-Fi profile it originally created. Re-saved it under system settings so it won't drop again.
              </div>
              <div class="phone-bar">
                <BakenMark uid="ph-amb" size={18} state="ambient" tight />
                <span>Composer stays open while tasks run</span>
              </div>
            </div>
          </div>
        </div>

        <!-- SCENE 03: ALIVE, NOT A CHATBOT -->
        <div class="app-window scene" data-scene="voice">
          <div class="voice-stage">
            <div class="voice-left">
              <span class="mono pair-eyebrow">FEELS ALIVE</span>
              <h3>See how it's doing at a glance.</h3>
              <p>Your companion isn't a dead text box. You can see when it's listening, when it's working on something in the background, and when it's resting — and you can talk to it out loud, hands-free.</p>
              <div class="mini-states">
                <div class="ms-pill"><BakenMark uid="ms-load" size={24} state="loading" /> <span>Waking up</span></div>
                <div class="ms-pill"><BakenMark uid="ms-conn" size={24} state="connecting" /> <span>Reconnecting</span></div>
                <div class="ms-pill"><BakenMark uid="ms-amb" size={24} state="ambient" /> <span>Finished a task</span></div>
                <div class="ms-pill"><BakenMark uid="ms-deg" size={24} state="degraded" /> <span>Away from home</span></div>
              </div>
            </div>

            <div class="voice-right">
              <div class="mascot-wrap">
                <svg width="96" height="96" viewBox="-190 -190 380 380" aria-hidden="true">
                  <path d={MASCOT_BODIES.blob} fill="#1E7BF0" />
                  <g transform="rotate(-6)">
                    <rect x="-56" y="-56" width="112" height="112" rx="26" fill="#F7F7F7" />
                    <g class="m-gaze"><g class="eye-blink" set:html={GLYPHS.listening} /></g>
                  </g>
                </svg>
              </div>
              <div class="v-bars" aria-hidden="true">
                <span style="--h:34%"></span><span style="--h:76%"></span><span style="--h:52%"></span>
                <span style="--h:94%"></span><span style="--h:62%"></span><span style="--h:82%"></span>
                <span style="--h:44%"></span>
              </div>
              <span class="mono voice-tag">Hands-free voice · runs on your own machine</span>
            </div>
          </div>
        </div>
      </div>

      <div class="scene-tabs" id="sceneTabs" role="tablist" aria-label="What Baken does">
        <button type="button" class="scene-tab active" data-target="desktop" role="tab" aria-selected="true">
          <span class="mono">01</span> Remembers your world
        </button>
        <button type="button" class="scene-tab" data-target="pair" role="tab" aria-selected="false">
          <span class="mono">02</span> Goes with you on your phone
        </button>
        <button type="button" class="scene-tab" data-target="voice" role="tab" aria-selected="false">
          <span class="mono">03</span> Talks &amp; works in the background
        </button>
      </div>
    </div>
  </section>

  <!-- FULL-BLEED ELASTIC STRINGS BOARD (pull any block, snaps back home) -->
  <StringsCanvas />

  <!-- WHY THIS MATTERS: WHAT YOU KEEP vs WHAT CAN DISAPPEAR -->
  <section class="band" id="details">
    <div class="container">
      <div class="band-head">
        <h2>Built so it can't be taken<br />away from you tomorrow.</h2>
        <p>When an AI lives in a company's cloud, they decide what it's allowed to remember, how much it costs next month, and when to shut it down. Baken flips that completely.</p>
      </div>

      <div class="clean-grid">
        <div class="clean-item">
          <h3>It actually remembers you.</h3>
          <p>Everything your companion learns — your projects, your preferences, what you decided three months ago — is saved as plain, readable files on your own computer. You can open them, edit them, or back them up anytime.</p>
        </div>
        <div class="clean-item">
          <h3>Change the brain, keep the companion.</h3>
          <p>Models get better every month, and providers change their rules overnight. Because your companion's memory and personality live on your machine, you can swap the underlying AI model whenever you want without starting over from a blank slate.</p>
        </div>
        <div class="clean-item">
          <h3>Never waits for you to stare at a spinner.</h3>
          <p>Hand off a big task and keep talking, or lock your phone and walk away. Your computer does the heavy lifting in the background and brings the answer back into the conversation when it's ready.</p>
        </div>
        <div class="clean-item">
          <h3>Points at your life, not at the app.</h3>
          <p>No fake streaks for opening the app, no subscription traps, and no guilt notifications. Baken is built to help you ship your work, run your home, and close the app when you're done.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- PAIRED IN A MINUTE -->
  <section class="band band-rule" id="pair">
    <div class="container">
      <div class="band-head centered">
        <h2>Up and running in a minute.</h2>
        <p>Your computer holds the memory and does the work. Your phone is your window into it from anywhere.</p>
      </div>

      <div class="steps-row">
        <div class="step">
          <span class="step-idx mono">01</span>
          <h3>Put Baken on your computer.</h3>
          <p>Run it on the machine you already own — with a local model on your graphics card, or connected to the cloud model you prefer.</p>
          <div class="req mono">Windows or Linux · local or cloud models</div>
        </div>

        <div class="step">
          <span class="step-idx mono">02</span>
          <h3>Install the phone app.</h3>
          <p>Download Baken on Android. There is no account to create and nothing to subscribe to.</p>
          <div class="req mono">Android 8.0 or later · free download</div>
        </div>

        <div class="step">
          <span class="step-idx mono">03</span>
          <h3>Scan the code on your screen.</h3>
          <p>Point your phone at the code on your computer. They lock directly to each other, encrypted end to end.</p>
          <div class="req mono">Direct connection · no middleman server</div>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="band band-rule" id="faq">
    <div class="container faq-container">
      <div class="band-head centered">
        <h2>Questions</h2>
      </div>

      <div class="faq-list">
        <details open>
          <summary>What happens if Baken stops being updated tomorrow?</summary>
          <p>Your companion keeps working. The app is open source, it runs on your own machine without calling any server we own, and all of your companion's memory sits in plain text files on your hard drive.</p>
        </details>
        <details>
          <summary>Is Baken free?</summary>
          <p>Yes. Baken is free and open source. If you run local models on your own computer, it costs nothing to run. If you connect a cloud model, you only pay that provider for what you use.</p>
        </details>
        <details>
          <summary>Do I need my own computer?</summary>
          <p>Yes. Your companion lives on a computer or home server you control so that your memory, files, and tools stay in your hands. The phone app connects straight to that computer.</p>
        </details>
        <details>
          <summary>What happens when I switch to a newer AI model?</summary>
          <p>Your companion stays the same. Its memory, history, and habits aren't locked inside OpenAI, Anthropic, or Google — they stay on your machine, and the new model picks right up where the last one left off.</p>
        </details>
        <details>
          <summary>Who can see my conversations?</summary>
          <p>Only you. There is no Baken account and no central cloud database. Your phone and your computer talk directly to each other with a key only the two of them share.</p>
        </details>
      </div>
    </div>
  </section>

  <!-- CLOSING -->
  <section class="band band-rule">
    <div class="container hero-center">
      <BakenMark uid="close" size={48} state="idle" />
      <h2 class="closing-h2">Keep what you build together.</h2>
      <p class="hero-lead" style="margin-bottom:28px">
        Free and open source on Android, Windows, and Linux. No account, no lock-in.
      </p>
      <div class="hero-cta-row">
        <a class="btn btn-primary" href={LINKS.releases} target="_blank" rel="noreferrer" data-umami-event="download-footer">
          Download Baken
        </a>
        <a class="btn btn-outline" href={LINKS.appRepo} target="_blank" rel="noreferrer">
          Source on GitHub
        </a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .hero { padding: 56px 0 88px; }
  .hero-center { display: flex; flex-direction: column; align-items: center; text-align: center; }
  .eyebrow-pill {
    display: inline-flex; align-items: center; padding: 7px 16px; border-radius: 999px;
    font-size: 13px; font-weight: 500; color: var(--text); background: var(--pill-bg);
    border: 1px solid var(--border); box-shadow: var(--pill-shadow); margin-bottom: 28px;
    transition: transform 160ms ease, border-color 160ms ease;
  }
  .eyebrow-pill:hover { transform: translateY(-1px); border-color: var(--border-strong); }
  .hero h1 {
    margin: 0 0 22px; font-size: clamp(44px, 6.2vw, 74px);
    line-height: 1.03; letter-spacing: -0.045em; font-weight: 700; max-width: 14ch;
  }
  .hero-lead {
    margin: 0 0 32px; font-size: 16.5px; line-height: 1.64; color: var(--muted); max-width: 55ch;
  }
  .hero-cta-row { display: flex; flex-wrap: wrap; justify-content: center; gap: 12px; }
  .trust-row {
    margin-top: 24px; display: flex; flex-wrap: wrap; justify-content: center;
    gap: 10px 26px; font-size: 13px; color: var(--muted);
  }
  .trust-row span { display: inline-flex; align-items: center; gap: 7px; }
  .trust-row span::before { content: ""; width: 6px; height: 6px; border-radius: 50%; background: var(--stone-2); }

  .showcase-backdrop {
    margin-top: 56px; border-radius: 18px; padding: 44px 44px 0;
    background:
      radial-gradient(circle at 20% 0%, rgba(238, 90, 63, 0.16), transparent 46%),
      radial-gradient(circle at 82% 15%, rgba(62, 134, 178, 0.22), transparent 50%),
      radial-gradient(rgba(220, 230, 238, 0.16) 1px, transparent 1px),
      linear-gradient(160deg, #1b2f3d 0%, #0f1d28 55%, #0a141c 100%);
    background-size: auto, auto, 24px 24px, auto;
    border: 1px solid rgba(16, 32, 44, 0.12);
    box-shadow: 0 24px 64px rgba(10, 20, 28, 0.16);
    overflow: hidden;
  }

  .scene { display: none; }
  .scene.active { display: block; }

  .app-window {
    background: #0e161d; color: #e8eff4;
    border-radius: 14px 14px 0 0; border: 1px solid rgba(255, 255, 255, 0.1); border-bottom: none;
    overflow: hidden; box-shadow: 0 18px 48px rgba(0, 0, 0, 0.48);
  }

  .win-titlebar {
    height: 44px; padding: 0 16px; background: #0a1117;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    display: flex; align-items: center; justify-content: space-between; gap: 14px;
  }
  .win-left { display: flex; align-items: center; gap: 10px; }
  .win-tab { font-size: 12px; color: #7f96a8; padding: 4px 10px; border-radius: 6px; }
  .win-tab.active-tab { background: rgba(255, 255, 255, 0.07); color: #e8eff4; font-weight: 700; }
  .win-search {
    font-size: 11.5px; color: #6c8294; background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.07); padding: 4px 14px; border-radius: 6px;
  }
  .win-dots { display: flex; gap: 7px; }
  .win-dots span { width: 9px; height: 9px; border-radius: 50%; background: rgba(255, 255, 255, 0.16); }

  .win-body { display: grid; grid-template-columns: 56px 210px 1fr; min-height: 410px; }
  .win-rail {
    background: #091016; border-right: 1px solid rgba(255, 255, 255, 0.07);
    padding: 12px 0; display: flex; flex-direction: column; align-items: center; gap: 10px;
  }
  .rail-icon { width: 38px; height: 38px; border-radius: 10px; display: grid; place-items: center; }
  .rail-icon.rail-selected { background: rgba(238, 90, 63, 0.16); box-shadow: inset 0 0 0 1.5px #ee5a3f; }
  .win-sidebar {
    background: #0c141b; border-right: 1px solid rgba(255, 255, 255, 0.07);
    padding: 20px 14px; display: flex; flex-direction: column; gap: 18px;
  }
  .agent-hero { display: flex; flex-direction: column; align-items: center; text-align: center; gap: 4px; }
  .agent-hero strong { font-size: 15px; }
  .agent-sub { font-size: 10.5px; color: #7f96a8; }
  .side-nav { display: flex; flex-direction: column; gap: 4px; font-size: 13px; color: #9ab0c1; }
  .side-item { padding: 6px 8px; border-radius: 6px; }
  .side-threads { display: flex; flex-direction: column; gap: 4px; }
  .side-label { font-size: 10px; letter-spacing: 0.08em; color: #677d8f; padding: 0 8px 4px; }
  .thread { font-size: 12.5px; color: #8da2b3; padding: 6px 8px; border-radius: 6px; }
  .thread.active-thread { background: rgba(255, 255, 255, 0.07); color: #e8eff4; }

  .win-chat { padding: 24px 28px 20px; display: flex; flex-direction: column; justify-content: space-between; gap: 18px; }
  .chat-feed { display: flex; flex-direction: column; gap: 16px; }
  .msg-user {
    align-self: flex-end; background: #173447; color: #e8eff4;
    padding: 11px 16px; border-radius: 14px 14px 4px 14px; font-size: 14px; max-width: 78%;
  }
  .tool-fold {
    align-self: flex-start; display: inline-flex; align-items: center; gap: 8px;
    font-size: 12px; color: #88a0b2; padding: 5px 11px; border-radius: 7px;
    background: rgba(255, 255, 255, 0.04); border: 1px solid rgba(255, 255, 255, 0.08);
  }
  .fold-dot { width: 6px; height: 6px; border-radius: 50%; background: #ee5a3f; }
  .msg-agent { font-size: 14.5px; color: #dce6ee; max-width: 60ch; }
  .msg-agent p { margin: 0 0 10px; }
  .msg-agent ul { margin: 0; padding-left: 18px; display: flex; flex-direction: column; gap: 6px; color: #b5c7d4; }
  .msg-agent strong { color: #e8eff4; }
  .win-composer {
    display: flex; align-items: center; justify-content: space-between; padding: 12px 16px;
    border-radius: 10px; background: #14212c; border: 1px solid rgba(255, 255, 255, 0.09);
    font-size: 13.5px; color: #718799;
  }
  .comp-right { display: flex; align-items: center; gap: 10px; font-size: 11px; }
  .comp-mic { color: #ee5a3f; }

  .pair-stage, .voice-stage {
    padding: 40px 44px 44px; display: grid; grid-template-columns: 1.1fr 0.9fr;
    gap: 40px; align-items: center; min-height: 410px;
  }
  .pair-eyebrow { display: block; font-size: 11px; letter-spacing: 0.08em; color: #ee5a3f; margin-bottom: 10px; }
  .pair-panel h3, .voice-left h3 { margin: 0 0 12px; font-size: 28px; letter-spacing: -0.03em; line-height: 1.15; }
  .pair-panel p, .voice-left p { margin: 0 0 24px; color: #95abb9; font-size: 15px; max-width: 46ch; }
  .pair-state-row {
    display: inline-flex; align-items: center; gap: 16px; padding: 14px 18px;
    border-radius: 12px; background: #13212d; border: 1px solid rgba(255, 255, 255, 0.09);
  }
  .pair-state-row strong { display: block; font-size: 14px; }
  .pair-state-row span { font-size: 11.5px; color: #7f96a8; }

  .phone-mock {
    max-width: 310px; width: 100%; justify-self: center;
    background: #111c26; border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 26px; padding: 18px; display: flex; flex-direction: column; gap: 12px;
  }
  .phone-top { display: flex; justify-content: space-between; font-size: 11.5px; color: #7f96a8; padding-bottom: 8px; border-bottom: 1px solid rgba(255,255,255,0.07); }
  .phone-ok { color: #ee5a3f; }
  .phone-msg-u { align-self: flex-end; background: #1a3a4e; padding: 9px 12px; border-radius: 12px 12px 3px 12px; font-size: 12.5px; }
  .phone-tool { font-size: 11px; color: #7f96a8; }
