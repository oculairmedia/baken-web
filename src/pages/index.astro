<script is:inline>
  // Scene tabs
  const tabs = document.querySelectorAll('#sceneTabs .scene-tab');
  const scenes = document.querySelectorAll('.chart-stage .scene');
  tabs.forEach((btn) => {
    btn.addEventListener('click', () => {
      const target = btn.getAttribute('data-target');
      tabs.forEach((t) => {
        const active = t === btn;
        t.classList.toggle('active', active);
        t.setAttribute('aria-selected', String(active));
      });
      scenes.forEach((s) => s.classList.toggle('active', s.getAttribute('data-scene') === target));
    });
  });

  // Interactive Wadden Sea Transit Sightline (Kenning) + mascot gaze
  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const rear = document.getElementById('rearStone');
    const front = document.getElementById('frontStone');
    const ray = document.getElementById('sightRay');
    const glow = document.getElementById('sightGlow');
    const readout = document.getElementById('transitReadout');

    window.addEventListener('pointermove', (e) => {
      const nx = (e.clientX / window.innerWidth) * 2 - 1; // -1 .. +1
      const ny = (e.clientY / window.innerHeight) * 2 - 1;

      // Mascot eye gaze
      document.querySelectorAll('.m-gaze').forEach((g) => {
        g.setAttribute('transform', `translate(${(nx * 12).toFixed(1)}, ${(ny * 9).toFixed(1)})`);
      });

      // Parallax between rear shore stone (slow) and front buoy stone (faster)
      if (rear && front && ray && glow && readout) {
        const rearDx = nx * 7;
        const frontDx = nx * 24;
        rear.setAttribute('transform', `translate(${(468 + rearDx).toFixed(1)}, 2) scale(0.72)`);
        front.setAttribute('transform', `translate(${(468 + frontDx).toFixed(1)}, 2) scale(0.72)`);
        ray.setAttribute('x1', (540 + rearDx).toFixed(1));
        ray.setAttribute('x2', (540 + frontDx * 1.35).toFixed(1));

        const driftDeg = Math.abs(nx * 4.2);
        const aligned = driftDeg < 0.8;
        glow.setAttribute('opacity', aligned ? '1' : '0.35');
        ray.setAttribute('stroke', aligned ? 'rgba(238,90,63,0.85)' : 'rgba(220,230,238,0.28)');
        readout.textContent = aligned
          ? `Bearing aligned · ${driftDeg.toFixed(1)}° drift · channel locked`
          : `Sighting transit · ${driftDeg.toFixed(1)}° offset · bring marks in line`;
      }
    });
  }
</script>
