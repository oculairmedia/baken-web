---
import Layout from '../layouts/Layout.astro';
import BakenMark from '../components/BakenMark.astro';
import { LINKS, MASCOT_BODIES, GLYPHS } from '../lib/brand';
---

<Layout
  title="Baken — Own your AI. On every screen."
  description="AI agents that live on your own machine and travel with you to Android, Windows, and Linux. Direct peer-to-peer pairing, persistent memory, and zero vendor lock-in."
>
  <!-- CENTERED EDITORIAL HERO (Osaurus pacing, spacing, and restraint) -->
  <section class="hero">
    <div class="container hero-center">
      <a class="eyebrow-pill" href={LINKS.releases} target="_blank" rel="noreferrer">
        Baken Public Beta &nbsp;·&nbsp; Free &amp; Open Source
      </a>

      <h1>Own your AI.<br />On every screen.</h1>

      <p class="hero-lead">
        AI agents that live on hardware you control. They read your files, run tools, remember what matters, and stay reachable on Android, Windows, and Linux — with your own local or cloud models.
      </p>

      <div class="hero-cta-row">
        <a class="btn btn-primary" href={LINKS.releases} target="_blank" rel="noreferrer" data-umami-event="download-hero">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 3v12m0 0 4.5-4.5M12 15 7.5 10.5M4 20h16" />
          </svg>
          Download latest release
        </a>
      </div>

      <div class="trust-row" aria-label="Highlights">
        <span>No account</span>
        <span>Android, Windows &amp; Linux</span>
        <span>Direct P2P</span>
        <span>End-to-end encrypted</span>
      </div>
    </div>

    <!-- FULL-WIDTH ATMOSPHERIC PRODUCT FRAME PEEKING ABOVE THE FOLD -->
    <div class="container">
      <div class="showcase-backdrop dark-surface">
        <!-- SCENE 01: DESKTOP WORKSPACE (default) -->
        <div class="app-window scene active" data-scene="desktop">
          <div class="win-titlebar">
            <div class="win-left">
              <BakenMark uid="win-top" size={18} state="idle" tight />
              <span class="win-tab active-tab">Meridian</span>
              <span class="win-tab">PM</span>
              <span class="win-tab">+</span>
            </div>
            <div class="win-search mono">Search agents, conversations, memory…</div>
            <div class="win-dots" aria-hidden="true">
              <span></span><span></span><span></span>
            </div>
          </div>

          <div class="win-body">
            <!-- Left Mascot Rail -->
            <aside class="win-rail" aria-label="Agent rail">
              <div class="rail-icon rail-selected" title="Meridian">
                <svg width="28" height="28" viewBox="-185 -185 370 370" aria-hidden="true">
                  <path d={MASCOT_BODIES.blob} fill="#1E7BF0" />
                  <rect x="-66" y="-66" width="132" height="132" rx="30" fill="#F7F7F7" transform="rotate(-8)" />
                  <g class="m-gaze"><g class="eye-blink" set:html={GLYPHS.idle} /></g>
                </svg>
              </div>
              <div class="rail-icon" title="Worker">
                <svg width="28" height="28" viewBox="-185 -185 370 370" aria-hidden="true">
                  <path d={MASCOT_BODIES.triangle} fill="#FF6A1A" />
                  <rect x="-58" y="-44" width="116" height="116" rx="28" fill="#F7F7F7" />
                  <g class="m-gaze" transform="translate(0,14)"><g class="eye-blink" set:html={GLYPHS.idle} /></g>
                </svg>
              </div>
              <div class="rail-icon" title="PM">
                <svg width="28" height="28" viewBox="-185 -185 370 370" aria-hidden="true">
                  <path d={MASCOT_BODIES.squircle} fill="#1DA34A" />
                  <rect x="-66" y="-66" width="132" height="132" rx="30" fill="#F7F7F7" transform="rotate(4)" />
                  <g class="m-gaze"><g class="eye-blink" set:html={GLYPHS.idle} /></g>
                </svg>
              </div>
              <div class="rail-icon" title="Research">
                <svg width="28" height="28" viewBox="-185 -185 370 370" aria-hidden="true">
                  <path d={MASCOT_BODIES.circle} fill="#E5484D" />
                  <rect x="-66" y="-66" width="132" height="132" rx="30" fill="#F7F7F7" transform="rotate(-5)" />
                  <g class="m-gaze"><g class="eye-blink" set:html={GLYPHS.idle} /></g>
                </svg>
              </div>
            </aside>

            <!-- Agent Info Column -->
            <aside class="win-sidebar">
              <div class="agent-hero">
                <div class="mascot-wrap">
                  <svg width="64" height="64" viewBox="-190 -190 380 380" aria-hidden="true">
                    <path d={MASCOT_BODIES.blob} fill="#1E7BF0" />
                    <g transform="rotate(-8)">
                      <rect x="-56" y="-56" width="112" height="112" rx="26" fill="#F7F7F7" />
                      <g class="m-gaze"><g class="eye-blink" set:html={GLYPHS.idle} /></g>
                    </g>
                  </svg>
                </div>
                <strong>Meridian</strong>
                <span class="mono agent-sub">Iroh · encrypted · local host</span>
              </div>

              <div class="side-nav">
                <div class="side-item">Memory</div>
                <div class="side-item">Schedules</div>
                <div class="side-item">Skills</div>
              </div>

              <div class="side-threads">
                <span class="mono side-label">PINNED</span>
                <div class="thread active-thread">Brand &amp; site launch</div>
                <div class="thread">Homelab stack audit</div>
                <div class="thread">Release checklist</div>
              </div>
            </aside>

            <!-- Conversation Pane -->
            <div class="win-chat">
              <div class="chat-feed">
                <div class="msg-user">
                  Check the site deploy and verify our tracking proxy isn't leaking anything.
                </div>

                <div class="tool-fold mono">
                  <span class="fold-dot"></span>
                  Worked · 2 tools · 1.4s
                </div>

                <div class="msg-agent">
                  <p>Both are live and verified.</p>
                  <ul>
                    <li><strong>baken.ca</strong> — HTTP 200 on Cloudflare Workers, assets cached at the edge.</li>
                    <li><strong>First-party proxy</strong> — returns 200 with zero third-party domain mentions in the HTML.</li>
                  </ul>
                </div>
              </div>

              <div class="win-composer">
                <span>Message Meridian…</span>
                <div class="comp-right mono">
                  <span>Direct P2P</span>
                  <span class="comp-mic">●</span>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- SCENE 02: PAIRING & ANDROID -->
        <div class="app-window scene" data-scene="pair">
          <div class="pair-stage">
            <div class="pair-panel">
              <span class="mono pair-eyebrow">HOST · QR INVITE</span>
              <h3>Scan to pair directly.</h3>
              <p>Mutual keys are negotiated between your device and your host over encrypted Iroh QUIC. No account, no cloud relay, nothing to paste.</p>
              <div class="pair-state-row">
                <BakenMark uid="sc-pair" size={44} state="connecting" />
                <div>
                  <strong>Channel seam connecting</strong>
                  <span class="mono">Seeking peer on LAN &amp; relay…</span>
                </div>
              </div>
            </div>

            <div class="phone-mock">
              <div class="phone-top mono">
                <span>baken</span>
                <span class="phone-ok">● paired</span>
              </div>
              <div class="phone-msg-u">Check what finished building while I was away.</div>
              <div class="phone-tool mono">Worked · 1 tool · 0.6s</div>
              <div class="phone-msg-a">
                Release build passed on main. Android APK and Desktop installer are uploaded and ready.
              </div>
              <div class="phone-bar">
                <BakenMark uid="ph-amb" size={18} state="ambient" tight />
                <span>Ambient · 1 update waiting</span>
              </div>
            </div>
          </div>
        </div>

        <!-- SCENE 03: LIVING PRESENCE & VOICE -->
        <div class="app-window scene" data-scene="voice">
          <div class="voice-stage">
            <div class="voice-left">
              <span class="mono pair-eyebrow">VOICE &amp; LIVING PRESENCE</span>
              <h3>Calm harbour. Expressive agents.</h3>
              <p>Baken's grounded basalt mark carries app and connection states only — boot, hydration, pairing, degraded offline, and quiet ambient alerts. Your Rive mascots below own every turn, voice call, and tool call.</p>
              <div class="mini-states">
                <div class="ms-pill"><BakenMark uid="ms-load" size={24} state="loading" /> <span>Hydrating</span></div>
                <div class="ms-pill"><BakenMark uid="ms-conn" size={24} state="connecting" /> <span>Pairing</span></div>
                <div class="ms-pill"><BakenMark uid="ms-amb" size={24} state="ambient" /> <span>Ambient</span></div>
                <div class="ms-pill"><BakenMark uid="ms-deg" size={24} state="degraded" /> <span>Offline</span></div>
              </div>
            </div>

            <div class="voice-right">
              <div class="mascot-wrap">
                <svg width="96" height="96" viewBox="-190 -190 380 380" aria-hidden="true">
                  <path d={MASCOT_BODIES.blob} fill="#1E7BF0" />
                  <g transform="rotate(-6)">
                    <rect x="-56" y="-56" width="112" height="112" rx="26" fill="#F7F7F7" />
                    <g class="m-gaze"><g class="eye-blink" set:html={GLYPHS.listening} /></g>
                  </g>
                </svg>
              </div>
              <div class="v-bars" aria-hidden="true">
                <span style="--h:34%"></span><span style="--h:76%"></span><span style="--h:52%"></span>
                <span style="--h:94%"></span><span style="--h:62%"></span><span style="--h:82%"></span>
                <span style="--h:44%"></span>
              </div>
              <span class="mono voice-tag">Local voice endpoint · streaming reply</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Osaurus-style 01 / 02 / 03 clean switcher directly beneath the showcase frame -->
      <div class="scene-tabs" id="sceneTabs" role="tablist" aria-label="Product views">
        <button type="button" class="scene-tab active" data-target="desktop" role="tab" aria-selected="true">
          <span class="mono">01</span> Desktop workspace
        </button>
        <button type="button" class="scene-tab" data-target="pair" role="tab" aria-selected="false">
          <span class="mono">02</span> QR pairing &amp; Android
        </button>
        <button type="button" class="scene-tab" data-target="voice" role="tab" aria-selected="false">
          <span class="mono">03</span> Voice &amp; living presence
        </button>
      </div>
    </div>
  </section>

  <!-- SECTION 1: PAIRED IN A MINUTE (open 3-column layout, hairline rules, zero box clutter) -->
  <section class="band" id="pair">
    <div class="container">
      <div class="band-head centered">
        <h2>Paired in a minute.</h2>
        <p>The phone and desktop apps talk directly to your own agent host. No account and no hosted relay in the middle.</p>
      </div>

      <div class="steps-row">
        <div class="step">
          <span class="step-idx mono">01</span>
          <h3>Run your agent host.</h3>
          <p>Keep your agents, git-backed memory, and local or cloud models running on your own Linux box or workstation.</p>
          <div class="req mono">Requires · Linux host + at least one configured agent</div>
        </div>

        <div class="step">
          <span class="step-idx mono">02</span>
          <h3>Install Baken.</h3>
          <p>Download the free Android APK, Windows installer, or Linux AppImage directly from GitHub Releases.</p>
          <div class="req mono">Requires · Android 8.0+, Windows x64, or Linux x64</div>
        </div>

        <div class="step">
          <span class="step-idx mono">03</span>
          <h3>Scan the pairing QR.</h3>
          <p>Generate a one-time invite on your host and scan it on your phone. Mutual keys bind automatically over encrypted Iroh QUIC.</p>
          <div class="req mono">Requires · One scan — works on LAN or away from home</div>
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION 2: THE MODELS CHANGE. EVERYTHING ELSE STAYS YOURS. -->
  <section class="band band-rule" id="features">
    <div class="container">
      <div class="band-head">
        <h2>Your machine does the work.<br />Your phone goes with you.</h2>
        <p>Everything you configure on your host is immediately ready on every screen — nothing to set up twice.</p>
      </div>

      <div class="clean-grid">
        <div class="clean-item">
          <h3>Every agent from your host.</h3>
          <p>Pick an agent and watch replies stream in with each tool folded cleanly underneath. Switch agents without losing context. Same agent, same memory.</p>
        </div>
        <div class="clean-item">
          <h3>Talk hands-free.</h3>
          <p>Use on-device speech or your own self-hosted Whisper and Kokoro voice server. Replies stream out loud sentence by sentence with any model.</p>
        </div>
        <div class="clean-item">
          <h3>Replies keep going.</h3>
          <p>Lock your phone or switch apps mid-turn. Your host finishes the work, and the completed answer and artifacts are waiting when you return.</p>
        </div>
        <div class="clean-item">
          <h3>Swap models without starting over.</h3>
          <p>Your memory lives in plain git-tracked files on your own hardware. Move between local GPU models and cloud providers without losing history.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION 3: PRIVATE BY DEFAULT -->
  <section class="band band-rule" id="privacy">
    <div class="container">
      <div class="band-head">
        <h2>Private by default.</h2>
        <p>Your conversations, memory, tools, and keys never leave your own infrastructure unless you choose a cloud model.</p>
      </div>

      <div class="clean-grid">
        <div class="clean-item">
          <h3>End-to-end encrypted.</h3>
          <p>QR pairing establishes device keys only your client and host know. Every frame travels encrypted over Iroh QUIC, even on your local network.</p>
        </div>
        <div class="clean-item">
          <h3>Nothing runs in our cloud.</h3>
          <p>No Baken backend, no hosted conversation store, and no account database. Local models answer directly from your own hardware.</p>
        </div>
        <div class="clean-item">
          <h3>No account.</h3>
          <p>Install, scan, and start. Nothing to sign up for and no subscription wall between you and your own agents.</p>
        </div>
        <div class="clean-item">
          <h3>Open source &amp; open standards.</h3>
          <p>Built on open protocols — MCP tools, A2UI structured cards, and OpenAI-compatible speech endpoints — with full source on GitHub.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION 4: FAQ -->
  <section class="band band-rule" id="faq">
    <div class="container faq-container">
      <div class="band-head centered">
        <h2>Still have questions?</h2>
      </div>

      <div class="faq-list">
        <details open>
          <summary>Is Baken free?</summary>
          <p>Yes. Baken is free and open source on Android, Windows, and Linux. You only pay a model provider if you choose to connect a paid cloud API on your own host.</p>
        </details>
        <details>
          <summary>Do I need my own computer or server?</summary>
          <p>Yes. Baken is a companion client to an agent host running on your own Linux server, homelab, or workstation. Your agents, memory, and tools stay there.</p>
        </details>
        <details>
          <summary>What platforms are supported today?</summary>
          <p>Android 8.0+ (APK), Windows x64 (.exe / .msi), and Linux x64 (AppImage), paired with the Linux Iroh host wrapper. All builds ship together on GitHub Releases.</p>
        </details>
        <details>
          <summary>Do models run on the phone?</summary>
          <p>Replies come from your host, so your phone gets whatever local GPU or cloud models your host can run. On-device speech recognition can run locally on Android.</p>
        </details>
        <details>
          <summary>Is the connection secure?</summary>
          <p>Yes. QR pairing sets up peer keys shared only between your client and your host, and every request after that is encrypted end to end over Iroh QUIC.</p>
        </details>
        <details>
          <summary>It's a public beta — what should I expect?</summary>
          <p>Frequent GitHub releases and active iteration as the Meridian → Baken brand transition wraps up. File bugs or feature requests directly on the GitHub repo.</p>
        </details>
      </div>
    </div>
  </section>

  <!-- CLOSING BAND -->
  <section class="band band-rule closing">
    <div class="container hero-center">
      <BakenMark uid="close" size={52} state="idle" />
      <h2 class="closing-h2">Own your AI. On every screen.</h2>
      <p class="hero-lead" style="margin-bottom:28px">
        Free and open source. No account, no subscription. Pair with your host in a minute.
      </p>
      <div class="hero-cta-row">
        <a class="btn btn-primary" href={LINKS.releases} target="_blank" rel="noreferrer" data-umami-event="download-footer">
          Download latest release
        </a>
        <a class="btn btn-outline" href={LINKS.appRepo} target="_blank" rel="noreferrer">
          View on GitHub
        </a>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* Hero */
  .hero {
    padding: 58px 0 40px;
  }
  .hero-center {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .eyebrow-pill {
    display: inline-flex;
    align-items: center;
    padding: 7px 16px;
    border-radius: 999px;
    font-size: 13px;
    font-weight: 500;
    color: var(--text);
    background: var(--pill-bg);
    border: 1px solid var(--border);
    box-shadow: var(--pill-shadow);
    margin-bottom: 30px;
    transition: transform 160ms ease, border-color 160ms ease;
  }
  .eyebrow-pill:hover {
    transform: translateY(-1px);
    border-color: var(--border-strong);
  }
  .hero h1 {
    margin: 0 0 22px;
    font-size: clamp(44px, 6.2vw, 74px);
    line-height: 1.03;
    letter-spacing: -0.045em;
    font-weight: 700;
    max-width: 14ch;
  }
  .hero-lead {
    margin: 0 0 32px;
    font-size: 16.5px;
    line-height: 1.62;
    color: var(--muted);
    max-width: 54ch;
  }
  .hero-cta-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
  }
  .trust-row {
    margin-top: 24px;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px 26px;
    font-size: 13px;
    color: var(--muted);
  }
  .trust-row span {
    display: inline-flex;
    align-items: center;
    gap: 7px;
  }
  .trust-row span::before {
    content: "";
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--stone-2);
  }

  /* Atmospheric Product Frame (Osaurus signature below-the-fold peek) */
  .showcase-backdrop {
    margin-top: 56px;
    border-radius: 18px;
    padding: 44px 44px 0;
    background:
      radial-gradient(circle at 20% 0%, rgba(238, 90, 63, 0.16), transparent 46%),
      radial-gradient(circle at 82% 15%, rgba(62, 134, 178, 0.22), transparent 50%),
      radial-gradient(rgba(220, 230, 238, 0.16) 1px, transparent 1px),
      linear-gradient(160deg, #1b2f3d 0%, #0f1d28 55%, #0a141c 100%);
    background-size: auto, auto, 24px 24px, auto;
    border: 1px solid rgba(16, 32, 44, 0.12);
    box-shadow: 0 24px 64px rgba(10, 20, 28, 0.16);
    overflow: hidden;
  }

  .scene { display: none; }
  .scene.active { display: block; }

  .app-window {
    background: #0e161d;
    color: #e8eff4;
    border-radius: 14px 14px 0 0;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-bottom: none;
    overflow: hidden;
    box-shadow: 0 18px 48px rgba(0, 0, 0, 0.48);
  }

  .win-titlebar {
    height: 44px;
    padding: 0 16px;
    background: #0a1117;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
  }
  .win-left { display: flex; align-items: center; gap: 10px; }
  .win-tab { font-size: 12px; color: #7f96a8; padding: 4px 10px; border-radius: 6px; }
  .win-tab.active-tab { background: rgba(255, 255, 255, 0.07); color: #e8eff4; font-weight: 700; }
  .win-search {
    font-size: 11.5px; color: #6c8294; background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.07); padding: 4px 14px; border-radius: 6px;
  }
  .win-dots { display: flex; gap: 7px; }
  .win-dots span { width: 9px; height: 9px; border-radius: 50%; background: rgba(255, 255, 255, 0.16); }

  .win-body {
    display: grid;
    grid-template-columns: 56px 210px 1fr;
    min-height: 410px;
  }
  .win-rail {
    background: #091016;
    border-right: 1px solid rgba(255, 255, 255, 0.07);
    padding: 12px 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
  }
  .rail-icon {
    width: 38px; height: 38px; border-radius: 10px; display: grid; place-items: center;
  }
  .rail-icon.rail-selected {
    background: rgba(238, 90, 63, 0.16);
    box-shadow: inset 0 0 0 1.5px #ee5a3f;
  }
  .win-sidebar {
    background: #0c141b;
    border-right: 1px solid rgba(255, 255, 255, 0.07);
    padding: 20px 14px;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .agent-hero { display: flex; flex-direction: column; align-items: center; text-align: center; gap: 4px; }
  .agent-hero strong { font-size: 15px; }
  .agent-sub { font-size: 10.5px; color: #7f96a8; }
  .side-nav { display: flex; flex-direction: column; gap: 4px; font-size: 13px; color: #9ab0c1; }
  .side-item { padding: 6px 8px; border-radius: 6px; }
  .side-threads { display: flex; flex-direction: column; gap: 4px; }
  .side-label { font-size: 10px; letter-spacing: 0.08em; color: #677d8f; padding: 0 8px 4px; }
  .thread { font-size: 12.5px; color: #8da2b3; padding: 6px 8px; border-radius: 6px; }
  .thread.active-thread { background: rgba(255, 255, 255, 0.07); color: #e8eff4; }

  .win-chat {
    padding: 24px 28px 20px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 18px;
  }
  .chat-feed { display: flex; flex-direction: column; gap: 16px; }
  .msg-user {
    align-self: flex-end;
    background: #173447;
    color: #e8eff4;
    padding: 11px 16px;
    border-radius: 14px 14px 4px 14px;
    font-size: 14px;
    max-width: 78%;
  }
  .tool-fold {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 12px;
    color: #88a0b2;
    padding: 5px 11px;
    border-radius: 7px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
  }
  .fold-dot { width: 6px; height: 6px; border-radius: 50%; background: #ee5a3f; }
  .msg-agent { font-size: 14.5px; color: #dce6ee; max-width: 60ch; }
  .msg-agent p { margin: 0 0 10px; }
  .msg-agent ul { margin: 0; padding-left: 18px; display: flex; flex-direction: column; gap: 6px; color: #b5c7d4; }
  .msg-agent strong { color: #e8eff4; }
  .win-composer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 16px;
    border-radius: 10px;
    background: #14212c;
    border: 1px solid rgba(255, 255, 255, 0.09);
    font-size: 13.5px;
    color: #718799;
  }
