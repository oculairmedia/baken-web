    font-size: 13.5px; color: #C6C6D0; line-height: 1.55;
  }

  /* 5. Clean 2x2 Grid */
  .clean-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 44px 64px; }
  .clean-item { padding-top: 22px; border-top: 1px solid var(--border); }
  .clean-item h3 { margin: 0 0 10px; font-size: 19px; letter-spacing: -0.025em; }
  .clean-item p { margin: 0; font-size: 15px; color: var(--muted); max-width: 48ch; }
  .clean-item strong { color: var(--text); }

  /* 6. FAQ */
  .faq-container { max-width: 760px; }
  .faq-list { border-top: 1px solid var(--border); }
  .faq-list details { border-bottom: 1px solid var(--border); padding: 22px 0; }
  .faq-list summary {
    cursor: pointer; font-size: 17px; font-weight: 700; letter-spacing: -0.02em;
    list-style: none; display: flex; align-items: center; justify-content: space-between; gap: 16px;
  }
  .faq-list summary::-webkit-details-marker { display: none; }
  .faq-list summary::after { content: "+"; color: var(--muted); font-size: 22px; font-weight: 500; line-height: 1; }
  .faq-list details[open] summary::after { content: "−"; color: var(--stone-2); }
  .faq-list details p { margin: 12px 0 0; font-size: 15px; color: var(--muted); max-width: 62ch; }

  /* 7. Why Baken Origin Coda at the Bottom */
  /* Waghenaer chart as the section's ground: full-bleed engraving behind the copy,
     faded under the text column, brighter at the open right side, with slow scroll parallax. */
  .why-chart {
    position: relative;
    overflow: hidden;
    isolation: isolate;
  }
  .why-chart-bg {
    position: absolute;
    z-index: 0;
    /* oversize vertically so the parallax drift never reveals an edge */
    left: 0; right: 0; top: -12%; bottom: -12%;
    background-color: var(--text);
    /* Dots drawn at native size (1 mask px = 1 CSS px, 2320px wide) so the dither stays crisp
       instead of being downscaled into grey mush; the section shows a crop of the channels. */
    -webkit-mask-image:
      url('/art/waghenaer-vlie-marsdiep-1583.png'),
      linear-gradient(90deg, rgba(0,0,0,0.30) 0%, rgba(0,0,0,0.05) 14%, rgba(0,0,0,0.05) 46%, rgba(0,0,0,0.85) 62%, rgba(0,0,0,1) 100%);
            mask-image:
      url('/art/waghenaer-vlie-marsdiep-1583.png'),
      linear-gradient(90deg, rgba(0,0,0,0.30) 0%, rgba(0,0,0,0.05) 14%, rgba(0,0,0,0.05) 46%, rgba(0,0,0,0.85) 62%, rgba(0,0,0,1) 100%);
    -webkit-mask-size: 2320px auto, 100% 100%;
            mask-size: 2320px auto, 100% 100%;
    -webkit-mask-position: 50% 42%, 0 0;
            mask-position: 50% 42%, 0 0;
    -webkit-mask-repeat: no-repeat;
            mask-repeat: no-repeat;
    -webkit-mask-composite: source-in;
            mask-composite: intersect;
    opacity: 0.62;
    transform: translate3d(0, var(--chart-shift, 0px), 0);
    will-change: transform;
    pointer-events: none;
  }
  /* soft top/bottom fade into neighbouring sections */
  .why-chart::before,
  .why-chart::after {
    content: "";
    position: absolute;
    left: 0; right: 0;
    height: 120px;
    z-index: 1;
    pointer-events: none;
  }
  .why-chart::before { top: 0;    background: linear-gradient(var(--band-tinted), transparent); }
  .why-chart::after  { bottom: 0; background: linear-gradient(transparent, var(--band-tinted)); }
  .why-chart-inner { position: relative; z-index: 2; }
  /* Soft scrim under the copy so body text always clears the chart */
  .why-chart .origin-copy {
    position: relative;
  }
  .why-chart .origin-copy::before {
    content: "";
    position: absolute;
    inset: -40px -56px -40px -80px;
    z-index: -1;
    background: radial-gradient(ellipse at 40% 50%, var(--band-tinted) 55%, transparent 80%);
    pointer-events: none;
  }
  .why-chart .origin-copy p { color: var(--text); opacity: 0.78; }
  .why-chart-cap {
    margin: 56px 0 0;
    font-family: ui-monospace, 'JetBrains Mono', SFMono-Regular, Menlo, monospace;
    font-size: 10.5px;
    letter-spacing: 0.05em;
    color: var(--muted);
  }
  .why-chart-cap em { font-style: italic; color: var(--text); }

  .origin-grid {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: 52px;
    align-items: center;
  }
  .origin-copy h2 {
    margin: 0 0 16px;
    font-size: clamp(30px, 3.6vw, 42px);
    line-height: 1.08;
    letter-spacing: -0.04em;
  }
  .origin-copy p {
    margin: 0 0 14px;
    font-size: 15.5px;
    color: var(--muted);
    max-width: 56ch;
  }
  .origin-copy em { color: var(--text); font-style: italic; }

  .origin-instrument {
    background: #0B0B0D;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 12px;
    padding: 18px 20px 14px;
  }
  .transit-meta {
    display: flex; align-items: center; justify-content: space-between;
