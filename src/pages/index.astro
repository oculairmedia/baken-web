---
import Layout from '../layouts/Layout.astro';
import BakenMark from '../components/BakenMark.astro';
import StringsCanvas from '../components/StringsCanvas.astro';
import { LINKS, MASCOT_BODIES, GLYPHS, BAKEN_ANCHOR, BAKEN_PEBBLE } from '../lib/brand';
---

<Layout>
  <!-- 1. HERO: WHAT IT DOES + CAST OF MASCOTS + FULL PRODUCT WINDOW -->
  <section class="hero">
    <div class="container hero-center">
      <!-- Mascot Cast Row (Grok Bot / Muse visual warmth up top) -->
      <div class="mascot-lineup" aria-hidden="true">
        <div class="mascot-wrap m-chip" title="Meridian">
          <svg width="46" height="46" viewBox="-185 -185 370 370">
            <path d={MASCOT_BODIES.blob} fill="#1E7BF0" />
            <rect x="-62" y="-62" width="124" height="124" rx="28" fill="#F7F7F7" transform="rotate(-8)" />
            <g class="m-gaze"><g class="eye-blink" set:html={GLYPHS.idle} /></g>
          </svg>
        </div>
        <div class="mascot-wrap m-chip" style="animation-delay:-1.1s" title="Builder">
          <svg width="44" height="44" viewBox="-185 -185 370 370">
            <path d={MASCOT_BODIES.triangle} fill="#FF6A1A" />
            <rect x="-56" y="-42" width="112" height="112" rx="26" fill="#F7F7F7" />
            <g class="m-gaze" transform="translate(0,14)"><g class="eye-blink" set:html={GLYPHS.idle} /></g>
          </svg>
        </div>
        <div class="baken-hero-badge">
          <BakenMark uid="hero-mark" size={42} state="idle" />
        </div>
        <div class="mascot-wrap m-chip" style="animation-delay:-2.2s" title="Planner">
          <svg width="44" height="44" viewBox="-185 -185 370 370">
            <path d={MASCOT_BODIES.squircle} fill="#1DA34A" />
            <rect x="-62" y="-62" width="124" height="124" rx="28" fill="#F7F7F7" transform="rotate(5)" />
            <g class="m-gaze"><g class="eye-blink" set:html={GLYPHS.idle} /></g>
          </svg>
        </div>
        <div class="mascot-wrap m-chip" style="animation-delay:-3.1s" title="Archivist">
          <svg width="44" height="44" viewBox="-185 -185 370 370">
            <path d={MASCOT_BODIES.circle} fill="#E5484D" />
            <rect x="-62" y="-62" width="124" height="124" rx="28" fill="#F7F7F7" transform="rotate(-5)" />
            <g class="m-gaze"><g class="eye-blink" set:html={GLYPHS.idle} /></g>
          </svg>
        </div>
      </div>

      <h1>AI agents you can give<br />real work to.</h1>

      <p class="hero-lead">
        Baken gives you a team of agents that live on your own computer, remember everything you teach them, and come with you on your phone. Hand them a task, close the lid, and come back to finished work.
      </p>

      <div class="hero-cta-row">
        <a class="btn btn-primary" href={LINKS.releases} target="_blank" rel="noreferrer" data-umami-event="download-hero">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 3v12m0 0 4.5-4.5M12 15 7.5 10.5M4 20h16" />
          </svg>
          Download for Android, Windows &amp; Linux
        </a>
        <a class="btn btn-outline" href="#capabilities">
          See what they do
        </a>
      </div>
    </div>

    <!-- HERO PRODUCT SHOWCASE: FULL DESKTOP + PHONE CONTINUITY -->
    <div class="container">
      <div class="showcase-stage dark-surface">
        <div class="app-window">
          <div class="win-titlebar">
            <div class="win-left">
              <BakenMark uid="win-top" size={18} state="idle" tight />
              <span class="win-tab active-tab">Meridian</span>
              <span class="win-tab">Builder</span>
              <span class="win-tab">Planner</span>
              <span class="win-tab">+</span>
            </div>
            <div class="win-search">Search agents, tasks, and memory…</div>
            <div class="win-dots" aria-hidden="true">
              <span></span><span></span><span></span>
            </div>
          </div>

          <div class="win-body">
            <aside class="win-rail" aria-label="Agent rail">
              <div class="rail-icon rail-selected" title="Meridian">
                <svg width="28" height="28" viewBox="-185 -185 370 370" aria-hidden="true">
                  <path d={MASCOT_BODIES.blob} fill="#1E7BF0" />
                  <rect x="-66" y="-66" width="132" height="132" rx="30" fill="#F7F7F7" transform="rotate(-8)" />
                  <g class="m-gaze"><g class="eye-blink" set:html={GLYPHS.idle} /></g>
                </svg>
              </div>
              <div class="rail-icon" title="Builder">
                <svg width="28" height="28" viewBox="-185 -185 370 370" aria-hidden="true">
                  <path d={MASCOT_BODIES.triangle} fill="#FF6A1A" />
                  <rect x="-58" y="-44" width="116" height="116" rx="28" fill="#F7F7F7" />
                  <g class="m-gaze" transform="translate(0,14)"><g class="eye-blink" set:html={GLYPHS.idle} /></g>
                </svg>
              </div>
              <div class="rail-icon" title="Planner">
                <svg width="28" height="28" viewBox="-185 -185 370 370" aria-hidden="true">
                  <path d={MASCOT_BODIES.squircle} fill="#1DA34A" />
                  <rect x="-66" y="-66" width="132" height="132" rx="30" fill="#F7F7F7" transform="rotate(4)" />
                  <g class="m-gaze"><g class="eye-blink" set:html={GLYPHS.idle} /></g>
                </svg>
              </div>
              <div class="rail-icon" title="Archivist">
                <svg width="28" height="28" viewBox="-185 -185 370 370" aria-hidden="true">
                  <path d={MASCOT_BODIES.circle} fill="#E5484D" />
                  <rect x="-66" y="-66" width="132" height="132" rx="30" fill="#F7F7F7" transform="rotate(-5)" />
                  <g class="m-gaze"><g class="eye-blink" set:html={GLYPHS.idle} /></g>
                </svg>
              </div>
            </aside>

            <aside class="win-sidebar">
              <div class="agent-hero">
                <div class="mascot-wrap">
                  <svg width="64" height="64" viewBox="-190 -190 380 380" aria-hidden="true">
                    <path d={MASCOT_BODIES.blob} fill="#1E7BF0" />
                    <g transform="rotate(-8)">
                      <rect x="-56" y="-56" width="112" height="112" rx="26" fill="#F7F7F7" />
                      <g class="m-gaze"><g class="eye-blink" set:html={GLYPHS.idle} /></g>
                    </g>
                  </svg>
                </div>
                <strong>Meridian</strong>
                <span class="agent-sub">Running on your computer</span>
              </div>

              <div class="side-nav">
                <div class="side-item">Memory</div>
                <div class="side-item">Routines</div>
                <div class="side-item">Skills</div>
              </div>

              <div class="side-threads">
                <span class="side-label">Active work</span>
                <div class="thread active-thread">Store domain &amp; launch</div>
                <div class="thread">Living room TV setup</div>
                <div class="thread">Monthly budget check</div>
              </div>
            </aside>

            <div class="win-chat">
              <div class="chat-feed">
                <div class="msg-user">
                  Wire the new store domain to Shopify, move support@ off my personal email, and verify nothing leaks on the live pages.
                </div>

                <div class="tool-fold">
                  <span class="fold-dot"></span>
                  Worked · configured DNS, email routing &amp; verified 4 pages · 18s
                </div>

                <div class="msg-agent">
                  <p>Done and verified live across the homepage, contact page, privacy policy, and terms:</p>
                  <ul>
                    <li><strong>redactedattire.com</strong> is primary with SSL active.</li>
                    <li><strong>support@redactedattire.com</strong> is live and verified; your personal address appears <strong>0</strong> times on the site.</li>
                  </ul>
                </div>
              </div>

              <div class="win-composer">
                <span>Ask for the next thing — composer stays open while tasks run…</span>
                <div class="comp-right">
                  <span>Synced to phone</span>
                  <span class="comp-mic">●</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. BENTO CAPABILITY GRID (x.ai/bot style: each card is a concrete behavior + live mini-UI artifact) -->
  <section class="band" id="capabilities">
    <div class="container">
      <div class="band-head">
        <h2>Everything you want in a companion.<br />And a teammate.</h2>
        <p>Every card below is a real surface in Baken — built to take work off your plate and remember how you like things done.</p>
      </div>

      <div class="bento-grid">
        <!-- Card 1: Remembers what you teach it -->
        <article class="bento-card">
          <div class="bento-copy">
            <h3>Gets smarter every week you use it.</h3>
            <p>Tell your agent a preference or a rule once. It writes it to its own memory on your machine and follows it from then on — no repeating yourself every session.</p>
          </div>
          <div class="bento-ui dark-surface">
            <div class="ui-msg-u">Never put my personal Gmail on any public store page.</div>
            <div class="ui-memory-toast">
              <div class="mem-head">
                <span class="mem-dot"></span>
                <strong>Saved to memory</strong>
                <span class="mem-file">projects/store-opsec.md</span>
              </div>
              <p>Keep personal email off all public storefronts and policies; always use the domain support@ address.</p>
            </div>
          </div>
        </article>

        <!-- Card 2: Every agent has its own computer (yours) -->
        <article class="bento-card">
          <div class="bento-copy">
            <h3>Works directly on your computer.</h3>
            <p>Your agents use your real files, terminal, browser, and local apps. You stay in control — auto-approve routine steps or have it ask before touching anything sensitive.</p>
          </div>
          <div class="bento-ui dark-surface">
            <div class="ui-term-head">
              <span>Computer · You're in control</span>
              <span class="ui-badge-live">● Working</span>
            </div>
            <div class="ui-diff">
              <div class="diff-file">wrangler.jsonc</div>
              <div class="diff-del">- "pattern": "staging.baken.ca"</div>
              <div class="diff-add">+ "pattern": "baken.ca", "custom_domain": true</div>
            </div>
            <div class="ui-approve-bar">
              <span>Deployed to baken.ca · HTTP 200 verified</span>
              <span class="ui-ok">✓ Done</span>
            </div>
          </div>
        </article>

        <!-- Card 3: Keeps working when you walk away (Fork & Relay) -->
        <article class="bento-card">
          <div class="bento-copy">
            <h3>Keeps working while you walk away.</h3>
            <p>Hand off a 20-minute job and keep chatting, or lock your phone and leave. Background workers finish the heavy lifting and bring the result back into the conversation.</p>
          </div>
          <div class="bento-ui dark-surface">
            <div class="ui-run-row">
              <BakenMark uid="b-run" size={24} state="loading" />
              <div class="run-meta">
                <strong>Scanning 45 repositories for leaked keys…</strong>
                <span>Background worker · 3m elapsed · chat stays unlocked</span>
              </div>
            </div>
            <div class="ui-relay">
              <strong>Meridian</strong> · just now<br />
              <span>Finished the scan in the background — found 2 old tokens, revoked both, and verified they return 401.</span>
            </div>
          </div>
        </article>

        <!-- Card 4: Agents work with each other -->
        <article class="bento-card">
          <div class="bento-copy">
            <h3>Agents delegate to each other.</h3>
            <p>Your main companion stays fast and conversational while delegating code, reviews, or research to specialized workers — and you see every handoff in one place.</p>
          </div>
          <div class="bento-ui dark-surface">
            <div class="ui-handoff">
              <div class="ho-row">
                <span class="ho-dot blue"></span>
                <div><strong>Meridian</strong> → <strong>PM-baken</strong><p>Handing over the 24dp notification icon and Rive state split.</p></div>
              </div>
              <div class="ho-row">
                <span class="ho-dot green"></span>
                <div><strong>PM-baken</strong><p>Wired into Android adaptive icon layers. Running check suite now.</p></div>
              </div>
            </div>
          </div>
        </article>

        <!-- Card 5: Hands-free voice -->
        <article class="bento-card">
          <div class="bento-copy">
            <h3>Talk to it out loud, hands-free.</h3>
            <p>Start a voice session from your phone or desktop. Speech is recognized locally and your agent answers out loud sentence by sentence from your own GPU or model.</p>
          </div>
          <div class="bento-ui dark-surface">
            <div class="ui-voice-box">
              <div class="mascot-wrap">
                <svg width="56" height="56" viewBox="-190 -190 380 380" aria-hidden="true">
                  <path d={MASCOT_BODIES.blob} fill="#1E7BF0" />
                  <g transform="rotate(-6)">
                    <rect x="-56" y="-56" width="112" height="112" rx="26" fill="#F7F7F7" />
                    <g class="m-gaze"><g class="eye-blink" set:html={GLYPHS.listening} /></g>
                  </g>
                </svg>
              </div>
              <div class="v-bars" aria-hidden="true">
                <span style="--h:36%"></span><span style="--h:82%"></span><span style="--h:54%"></span>
                <span style="--h:95%"></span><span style="--h:60%"></span><span style="--h:78%"></span>
                <span style="--h:40%"></span>
              </div>
              <span class="v-live">Speaking · 0:14</span>
            </div>
          </div>
        </article>

        <!-- Card 6: Phone + Desktop paired directly -->
        <article class="bento-card">
          <div class="bento-copy">
            <h3>Your computer's power, in your pocket.</h3>
            <p>Scan one code to pair your Android phone straight to your computer. Every agent, file, and conversation is there instantly — encrypted end to end with zero cloud middleman.</p>
          </div>
          <div class="bento-ui dark-surface">
            <div class="ui-pair-box">
              <BakenMark uid="b-pair" size={38} state="connecting" />
              <div class="pair-text">
                <strong>Pixel 9 Pro ⇄ Home Workstation</strong>
                <span>Direct encrypted tunnel · 0 cloud relays · instant resume</span>
              </div>
            </div>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- 3. GIVE EACH AGENT A JOB (Interactive Role Switcher — x.ai/bot's signature section adapted to Baken) -->
  <section class="band band-rule" id="jobs">
    <div class="container">
      <div class="band-head">
        <h2>Give each agent a job.</h2>
        <p>Run one personal companion for your day-to-day life, and spin up focused specialists for your code, your homelab, your store, or your research.</p>
      </div>

      <div class="jobs-pills" id="jobPills" role="tablist" aria-label="Agent roles">
        <button type="button" class="job-pill active" data-job="companion" role="tab" aria-selected="true">Daily Companion</button>
        <button type="button" class="job-pill" data-job="coding" role="tab" aria-selected="false">Code &amp; PRs</button>
        <button type="button" class="job-pill" data-job="homelab" role="tab" aria-selected="false">Home &amp; Media</button>
        <button type="button" class="job-pill" data-job="store" role="tab" aria-selected="false">Store &amp; Ops</button>
        <button type="button" class="job-pill" data-job="finances" role="tab" aria-selected="false">Finances &amp; Admin</button>
        <button type="button" class="job-pill" data-job="research" role="tab" aria-selected="false">Deep Research</button>
      </div>

      <div class="job-stage dark-surface" id="jobStage">
        <!-- Job 1: Daily Companion -->
        <div class="job-panel active" data-panel="companion">
          <div class="job-desc">
            <h3>Remembers the thread of your life across months.</h3>
            <p>Knows your family, your schedule, what you're building, and how you like to be talked to. Points at your real life — shipping your work, resting on time — never at fake app-open streaks.</p>
            <ul>
              <li>Picks up threads you paused weeks ago without re-explaining</li>
              <li>Reaches you across desktop, phone, voice, or chat rooms</li>
              <li>Stays honest when a plan won't work</li>
            </ul>
          </div>
          <div class="job-chat">
            <div class="jc-u">Did we ever fix that slow search on the media box?</div>
            <div class="jc-a">Yes — back on Nov 20 we moved DrunkenSlug direct into Sonarr and Radarr and scoped Nyaa to anime-only. Search dropped from 815ms to 370ms.</div>
          </div>
        </div>

        <!-- Job 2: Code & PRs -->
        <div class="job-panel" data-panel="coding">
          <div class="job-desc">
            <h3>Takes a bug from diagnosis to a verified PR.</h3>
            <p>Works in isolated git worktrees, runs the build and test suite, inspects failure logs bottom-up, and watches CI until the branch is genuinely ready to merge.</p>
            <ul>
              <li>Spawns fresh coding workers while staying in chat with you</li>
              <li>Simulates merges to catch conflicts before you click</li>
              <li>Verifies real artifacts on disk, never claims "done" on faith</li>
            </ul>
          </div>
          <div class="job-chat">
            <div class="jc-u">Review the open PRs and tell me the safe merge order.</div>
            <div class="jc-a">Checked all 6 open heads against main: merge #2469 first (zero overlap), then rebase #2471 (shares TimelineStreamReducer.kt). All required checks green on current SHA.</div>
          </div>
        </div>

        <!-- Job 3: Home & Media -->
        <div class="job-panel" data-panel="homelab">
          <div class="job-desc">
            <h3>Runs your home servers, TV, and smart home.</h3>
            <p>Connects to Proxmox, Docker, Home Assistant, Jellyfin, and your TV over ADB. Diagnoses why a stream buffered, expands a full RAM disk live, or puts on a movie from chat.</p>
            <ul>
              <li>Controls lights, speakers, and Google TV directly</li>
              <li>Watches container health and disk pressure before things crash</li>
              <li>Adds shows or movies and pops a quiet toast on the TV when ready</li>
            </ul>
          </div>
          <div class="job-chat">
            <div class="jc-u">Play I, Robot on the family room TV and set the transcode cleanup to 4 hours.</div>
            <div class="jc-a">Playing I, Robot (2004) on Family Room TV via DirectPlay, and updated Jellyfin's Clean Transcode Directory task to run every 4 hours.</div>
          </div>
        </div>

        <!-- Job 4: Store & Ops -->
        <div class="job-panel" data-panel="store">
          <div class="job-desc">
            <h3>Launch pages, domains, print files, and store ops.</h3>
            <p>Registers and wires Cloudflare DNS, sets up email routing, audits public pages for personal data leaks, generates print-ready vector artwork, and wires self-hosted analytics.</p>
            <ul>
              <li>End-to-end Cloudflare Workers, DNS, and Shopify API automation</li>
              <li>Generates exact 300 DPI print files and SVG brand kits</li>
              <li>First-party analytics proxies so third-party domains never leak</li>
            </ul>
          </div>
          <div class="job-chat">
            <div class="jc-u">Check what personal info is exposed on our live store policies.</div>
            <div class="jc-a">Verified all 4 live pages: 0 occurrences of your personal Gmail, name, or city. Only support@redactedattire.com is shown.</div>
          </div>
        </div>

        <!-- Job 5: Finances & Admin -->
        <div class="job-panel" data-panel="finances">
          <div class="job-desc">
            <h3>Keeps your household numbers and inbox clean.</h3>
            <p>Bridges bank imports into your self-hosted finance tracker, categorizes transactions with your household rules, and sweeps thousands of promo emails out of your inbox with a review brake before mutating.</p>
            <ul>
              <li>Works with self-hosted SureFinance, Invoice Ninja, and IMAP</li>
              <li>Proposes bulk changes with exact counts before touching data</li>
              <li>Respects hard privacy boundaries on work vs. personal data</li>
            </ul>
          </div>
          <div class="job-chat">
            <div class="jc-u">How much did we spend on dining out this month compared to last?</div>
            <div class="jc-a">Pulled from SureFinance: $342 across 9 transactions so far this month, down $118 from the same point last month.</div>
          </div>
        </div>

        <!-- Job 6: Deep Research -->
        <div class="job-panel" data-panel="research">
          <div class="job-desc">
            <h3>Digs through primary sources and writes it down.</h3>
            <p>Searches through your self-hosted SearXNG, crawls documentation, cross-checks claims against primary PDFs or commit history, and saves structured reference notes into your knowledge base.</p>
            <ul>
              <li>Verifies every quote and page number against the real source</li>
              <li>Writes durable notes to BookStack or your git memory repo</li>
              <li>Runs in the background while you keep working</li>
            </ul>
          </div>
          <div class="job-chat">
            <div class="jc-u">Pull verbatim quotes from the 2019 court order PDF and verify every page number.</div>
            <div class="jc-a">Extracted 8 complete-sentence quotes directly from the Document 435 text layer, verified each page number, and saved the manifest to SOURCES.md.</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 4. OWNERSHIP: FULL-BLEED ELASTIC STRINGS BOARD (Mistral-inspired) -->
  <StringsCanvas />

  <!-- 5. WHY THIS MATTERS + 3-STEP SETUP -->
  <section class="band" id="details">
    <div class="container">
      <div class="band-head">
        <h2>Built so it can't be taken<br />away from you tomorrow.</h2>
        <p>When an AI lives in a company's cloud, they decide what it's allowed to remember, how much it costs next month, and when to shut it down. Baken keeps the relationship on your side.</p>
      </div>

      <div class="clean-grid">
        <div class="clean-item">
          <h3>Plain files you actually own.</h3>
          <p>Everything your companion learns — your projects, the people in your life, what you decided three months ago — is saved as plain, readable files on your own computer. Open them, edit them, or back them up anytime.</p>
        </div>
        <div class="clean-item">
          <h3>Change the brain, keep the companion.</h3>
          <p>New models come out every month. Because your companion's memory and personality live on your machine, you can swap the underlying AI model whenever you want without starting over from a blank slate.</p>
        </div>
        <div class="clean-item">
          <h3>Up and running in three steps.</h3>
          <p><strong>1.</strong> Run Baken on your Windows or Linux computer. <strong>2.</strong> Install the free Android or Desktop app. <strong>3.</strong> Scan the code on your screen to lock them directly together — no account, no middleman server.</p>
        </div>
        <div class="clean-item">
          <h3>Points at your life, not at the app.</h3>
          <p>No fake streaks for opening the app, no subscription traps, and no guilt notifications. Baken is built to help you ship your work, run your home, and close the app when you're done.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 6. FAQ -->
  <section class="band band-rule" id="faq">
    <div class="container faq-container">
      <div class="band-head centered">
        <h2>Questions</h2>
      </div>

      <div class="faq-list">
        <details open>
          <summary>What happens if Baken stops being updated tomorrow?</summary>
          <p>Your companion keeps working. The app is open source, it runs on your own machine without calling any server we own, and all of your companion's memory sits in plain text files on your hard drive.</p>
        </details>
        <details>
          <summary>Is Baken free?</summary>
          <p>Yes. Baken is free and open source. If you run local models on your own computer, it costs nothing to run. If you connect a cloud model, you only pay that provider for what you use.</p>
        </details>
        <details>
          <summary>Do I need my own computer?</summary>
          <p>Yes. Your companion lives on a computer or home server you control so that your memory, files, and tools stay in your hands. The phone app connects straight to that computer.</p>
        </details>
        <details>
          <summary>What happens when I switch to a newer AI model?</summary>
          <p>Your companion stays the same. Its memory, history, and habits aren't locked inside OpenAI, Anthropic, or Google — they stay on your machine, and the new model picks right up where the last one left off.</p>
        </details>
        <details>
          <summary>Who can see my conversations?</summary>
          <p>Only you. There is no Baken account and no central cloud database. Your phone and your computer talk directly to each other with a key only the two of them share.</p>
        </details>
      </div>
    </div>
  </section>

  <!-- 7. THE "WHY BAKEN" ORIGIN & INTERACTIVE TRANSIT (MOVED TO THE END AS THE SIGNATURE CODA) -->
  <section class="band band-rule" id="why-baken">
    <div class="container">
      <div class="origin-grid">
        <div class="origin-copy">
          <h2>Why it's called Baken.</h2>
          <p>
            For four hundred years along the Dutch Wadden Sea, the sandbanks shifted with every tide. A chart drawn in spring could ground a ship by autumn. So islanders on Texel, Vlieland, and Terschelling built <em>bakens</em> — fixed landmarks of stone, iron, and timber set into the dunes.
          </p>
          <p>
            They worked in pairs. When a sailor lined up the smaller front mark against the tall rear mark on the shore — a sightline called a <em>kenning</em> — they knew they were in the safe channel, no matter how the water moved beneath them.
          </p>
          <p>
            AI shifts the same way today: providers change their rules, raise prices, or retire the model you relied on overnight. Baken is the fixed mark you own. The rear stone is your computer, holding years of memory; the front stone is your phone, aligned with it wherever you go.
          </p>
        </div>

        <!-- Interactive Wadden Sea Transit Instrument at the end of the story -->
        <div class="origin-instrument dark-surface" id="transitInstrument">
          <div class="transit-meta">
            <span>FIG. I — DE KENNING (WADDEN SEA TRANSIT)</span>
            <span class="transit-readout" id="transitReadout">Bearing aligned · 0.0° drift</span>
          </div>

          <svg class="transit-svg" id="transitSvg" viewBox="0 0 560 220" aria-label="Interactive seamark alignment">
            <defs>
              <radialGradient id="transitGlow" cx="50%" cy="52%" r="48%">
                <stop offset="0%" stop-color="#EE5A3F" stop-opacity="0.48" />
                <stop offset="60%" stop-color="#EE5A3F" stop-opacity="0.12" />
                <stop offset="100%" stop-color="#EE5A3F" stop-opacity="0" />
              </radialGradient>
            </defs>

            <path class="contour c1" d="M -20 176 C 140 124, 290 198, 450 144 C 510 124, 550 148, 580 136" />
            <path class="contour c2" d="M -20 142 C 120 92, 310 166, 470 112 C 520 96, 555 118, 580 104" />
            <path class="contour c3" d="M -20 106 C 150 58, 330 132, 480 80 C 530 64, 560 88, 580 74" />

            <line id="sightRay" x1="280" y1="12" x2="280" y2="208" stroke="rgba(238,90,63,0.7)" stroke-width="1.5" stroke-dasharray="4 4" />
            <circle id="sightGlow" cx="280" cy="112" r="76" fill="url(#transitGlow)" />

            <g id="rearStone" transform="translate(202, 24) scale(0.78)">
              <path d={BAKEN_ANCHOR} fill="#DCE6EE" />
            </g>
            <g id="frontStone" transform="translate(202, 24) scale(0.78)">
              <path d={BAKEN_PEBBLE} fill="#EE5A3F" />
            </g>

            <text x="18" y="204" fill="#7D93A5" font-size="10.5" font-family="ui-monospace, monospace">REAR · YOUR COMPUTER</text>
            <text x="392" y="204" fill="#EE5A3F" font-size="10.5" font-family="ui-monospace, monospace">FRONT · YOUR PHONE</text>
          </svg>
        </div>
      </div>
    </div>
  </section>

  <!-- 8. CLOSING -->
  <section class="band band-rule">
    <div class="container hero-center">
      <BakenMark uid="close" size={48} state="idle" />
      <h2 class="closing-h2">Keep what you build together.</h2>
      <p class="hero-lead" style="margin-bottom:28px">
        Free and open source on Android, Windows, and Linux. No account, no lock-in.
      </p>
      <div class="hero-cta-row">
        <a class="btn btn-primary" href={LINKS.releases} target="_blank" rel="noreferrer" data-umami-event="download-footer">
          Download Baken
        </a>
        <a class="btn btn-outline" href={LINKS.appRepo} target="_blank" rel="noreferrer">
          Source on GitHub
        </a>
      </div>
    </div>
  </section>
</Layout>

