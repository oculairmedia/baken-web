  .why-chart {
    position: relative;
    overflow: hidden;
    isolation: isolate;
  }
  .why-chart-bg {
    position: absolute;
    z-index: 0;
    /* oversize vertically so the parallax drift never reveals an edge */
    left: 0; right: 0; top: -12%; bottom: -12%;
    background-color: var(--text);
    /* Dots drawn at native size (1 mask px = 1 CSS px, 2320px wide) so the dither stays crisp
       instead of being downscaled into grey mush; the section shows a crop of the channels. */
    /* Three binary masks intersected: the dithered chart, a dithered horizontal falloff
       (clear behind the copy, full behind the instrument) and a dithered top/bottom falloff.
       The chart thins out by dropping dot cells, never by fading to grey. */
    -webkit-mask-image:
      url('/art/waghenaer-vlie-marsdiep-1583.png'),
      url('/art/dither-ramp-x.png'),
      url('/art/dither-ramp-y.png');
            mask-image:
      url('/art/waghenaer-vlie-marsdiep-1583.png'),
      url('/art/dither-ramp-x.png'),
      url('/art/dither-ramp-y.png');
    -webkit-mask-size: 2320px auto, 3840px 64px, 32px 100%;
            mask-size: 2320px auto, 3840px 64px, 32px 100%;
    -webkit-mask-position: 50% 42%, 50% 0, 0 0;
            mask-position: 50% 42%, 50% 0, 0 0;
    -webkit-mask-repeat: no-repeat, repeat-y, repeat-x;
            mask-repeat: no-repeat, repeat-y, repeat-x;
    -webkit-mask-composite: source-in, source-in;
            mask-composite: intersect, intersect;
    opacity: 0.62;
    transform: translate3d(0, var(--chart-shift, 0px), 0);
    will-change: transform;
    pointer-events: none;
  }
  .why-chart-inner { position: relative; z-index: 2; }
  .why-chart .origin-copy p { color: var(--text); opacity: 0.78; }
  /* Stacked layout: the copy spans the full width, so drop the horizontal mask
