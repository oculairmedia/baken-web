---
import Layout from '../layouts/Layout.astro';
import BakenMark from '../components/BakenMark.astro';
import StringsCanvas from '../components/StringsCanvas.astro';
import { LINKS, MASCOT_BODIES, GLYPHS, BAKEN_ANCHOR, BAKEN_PEBBLE } from '../lib/brand';
---

<Layout
  title="Baken — An AI companion that stays yours."
  description="In the shifting channels of the Wadden Sea, a baken was the fixed mark sailors took their bearings from. Baken is an AI companion that lives on your computer, goes with you on your phone, and keeps your memory in your own hands."
>
  <!-- HERO: NO PILL, NO AI CLICHÉS — JUST THE THESIS + INTERACTIVE TRANSIT ALIGNMENT -->
  <section class="hero">
    <div class="container hero-center">
      <h1>An AI companion<br />that stays yours.</h1>

      <p class="hero-lead">
        Most AI apps rent you a forgetful stranger on a company server — one policy change, price hike, or shutdown away from vanishing. Baken lives on your own computer and travels with you on your phone, so the memory you build together over years can never be taken away.
      </p>

      <div class="hero-cta-row">
        <a class="btn btn-primary" href={LINKS.releases} target="_blank" rel="noreferrer" data-umami-event="download-hero">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 3v12m0 0 4.5-4.5M12 15 7.5 10.5M4 20h16" />
          </svg>
          Download for Android, Windows &amp; Linux
        </a>
      </div>

      <div class="trust-row" aria-label="What stays in your control">
        <span>No account to get locked out of</span>
        <span>Can't be nerfed or shut down</span>
        <span>Memory stays on your machine</span>
      </div>
    </div>

    <!-- SIGNATURE INTERACTIVE ARTIFACT: THE TRANSIT LINE (KENNING / MERK) + PRODUCT SHOWCASE -->
    <div class="container">
      <div class="chart-stage dark-surface" id="bearing">
        <!-- Interactive Wadden Sea Transit Sightline Header -->
        <div class="transit-instrument" id="transitInstrument">
          <div class="transit-meta">
            <span class="transit-coord" id="transitCoord">53°22′N · 05°13′E &nbsp;—&nbsp; WADDEN SEA TRANSIT</span>
            <span class="transit-readout" id="transitReadout">Bearing aligned · 0.0° drift · channel locked</span>
          </div>

          <svg class="transit-svg" id="transitSvg" viewBox="0 0 1080 148" aria-label="Interactive seamark alignment">
            <defs>
              <radialGradient id="transitGlow" cx="50%" cy="52%" r="48%">
                <stop offset="0%" stop-color="#EE5A3F" stop-opacity="0.46" />
                <stop offset="60%" stop-color="#EE5A3F" stop-opacity="0.1" />
                <stop offset="100%" stop-color="#EE5A3F" stop-opacity="0" />
              </radialGradient>
            </defs>

            <!-- Bathymetric depth contour arcs (shifting sandbanks) -->
            <path class="contour c1" d="M -40 124 C 240 68, 460 144, 760 88 C 920 58, 1020 96, 1120 74" />
            <path class="contour c2" d="M -40 96 C 210 42, 510 122, 810 62 C 950 36, 1040 72, 1120 48" />
            <path class="contour c3" d="M -40 64 C 260 18, 540 92, 840 36 C 960 14, 1050 44, 1120 26" />

            <!-- Compass degree ticks along the horizon -->
            <g class="compass-ticks" stroke="rgba(220,230,238,0.16)" stroke-width="1">
              <line x1="140" y1="0" x2="140" y2="10" /><line x1="220" y1="0" x2="220" y2="6" />
              <line x1="300" y1="0" x2="300" y2="10" /><line x1="380" y1="0" x2="380" y2="6" />
              <line x1="460" y1="0" x2="460" y2="10" /><line x1="540" y1="0" x2="540" y2="16" stroke="rgba(238,90,63,0.7)" />
              <line x1="620" y1="0" x2="620" y2="10" /><line x1="700" y1="0" x2="700" y2="6" />
              <line x1="780" y1="0" x2="780" y2="10" /><line x1="860" y1="0" x2="860" y2="6" />
              <line x1="940" y1="0" x2="940" y2="10" />
            </g>

            <!-- Sightline ray (kenning) passing between the two stones -->
            <line id="sightRay" x1="540" y1="0" x2="540" y2="148" stroke="rgba(238,90,63,0.55)" stroke-width="1.5" stroke-dasharray="4 4" />
            <circle id="sightGlow" cx="540" cy="84" r="68" fill="url(#transitGlow)" />

            <!-- Rear Mark (Tall Basalt Stone — Your Computer / Fixed Memory) -->
            <g id="rearStone" transform="translate(468, 2) scale(0.72)">
              <path d={BAKEN_ANCHOR} fill="#DCE6EE" />
            </g>

            <!-- Front Mark (Vermilion Stone — Your Phone / Moving With You) -->
            <g id="frontStone" transform="translate(468, 2) scale(0.72)">
              <path d={BAKEN_PEBBLE} fill="#EE5A3F" />
            </g>

            <!-- Left & right nautical chart annotations -->
            <text x="28" y="84" fill="#7D93A5" font-size="11.5" font-family="ui-monospace, monospace">REAR MARK · YOUR COMPUTER (MEMORY &amp; WORK)</text>
            <text x="738" y="84" fill="#EE5A3F" font-size="11.5" font-family="ui-monospace, monospace">FRONT MARK · YOUR PHONE (ALWAYS IN LINE)</text>
          </svg>
        </div>

        <!-- LIVE PRODUCT WINDOW -->
        <div class="app-window scene active" data-scene="desktop">
          <div class="win-titlebar">
            <div class="win-left">
              <BakenMark uid="win-top" size={18} state="idle" tight />
              <span class="win-tab active-tab">Meridian</span>
              <span class="win-tab">Research</span>
              <span class="win-tab">+</span>
            </div>
            <div class="win-search">Search conversations and memory…</div>
            <div class="win-dots" aria-hidden="true">
              <span></span><span></span><span></span>
            </div>
          </div>

          <div class="win-body">
            <aside class="win-rail" aria-label="Companions">
              <div class="rail-icon rail-selected" title="Meridian">
                <svg width="28" height="28" viewBox="-185 -185 370 370" aria-hidden="true">
                  <path d={MASCOT_BODIES.blob} fill="#1E7BF0" />
                  <rect x="-66" y="-66" width="132" height="132" rx="30" fill="#F7F7F7" transform="rotate(-8)" />
                  <g class="m-gaze"><g class="eye-blink" set:html={GLYPHS.idle} /></g>
                </svg>
              </div>
              <div class="rail-icon" title="Builder">
                <svg width="28" height="28" viewBox="-185 -185 370 370" aria-hidden="true">
                  <path d={MASCOT_BODIES.triangle} fill="#FF6A1A" />
                  <rect x="-58" y="-44" width="116" height="116" rx="28" fill="#F7F7F7" />
                  <g class="m-gaze" transform="translate(0,14)"><g class="eye-blink" set:html={GLYPHS.idle} /></g>
                </svg>
              </div>
              <div class="rail-icon" title="Planner">
                <svg width="28" height="28" viewBox="-185 -185 370 370" aria-hidden="true">
                  <path d={MASCOT_BODIES.squircle} fill="#1DA34A" />
                  <rect x="-66" y="-66" width="132" height="132" rx="30" fill="#F7F7F7" transform="rotate(4)" />
                  <g class="m-gaze"><g class="eye-blink" set:html={GLYPHS.idle} /></g>
                </svg>
              </div>
              <div class="rail-icon" title="Archivist">
                <svg width="28" height="28" viewBox="-185 -185 370 370" aria-hidden="true">
                  <path d={MASCOT_BODIES.circle} fill="#E5484D" />
                  <rect x="-66" y="-66" width="132" height="132" rx="30" fill="#F7F7F7" transform="rotate(-5)" />
                  <g class="m-gaze"><g class="eye-blink" set:html={GLYPHS.idle} /></g>
                </svg>
              </div>
            </aside>

            <aside class="win-sidebar">
              <div class="agent-hero">
                <div class="mascot-wrap">
                  <svg width="64" height="64" viewBox="-190 -190 380 380" aria-hidden="true">
                    <path d={MASCOT_BODIES.blob} fill="#1E7BF0" />
                    <g transform="rotate(-8)">
                      <rect x="-56" y="-56" width="112" height="112" rx="26" fill="#F7F7F7" />
                      <g class="m-gaze"><g class="eye-blink" set:html={GLYPHS.idle} /></g>
                    </g>
                  </svg>
                </div>
                <strong>Meridian</strong>
                <span class="agent-sub">Lives on your computer</span>
              </div>

              <div class="side-nav">
                <div class="side-item">Memory</div>
                <div class="side-item">Routines</div>
                <div class="side-item">Skills</div>
              </div>

              <div class="side-threads">
                <span class="side-label">Threads</span>
                <div class="thread active-thread">Store launch &amp; domain</div>
                <div class="thread">Living room TV setup</div>
                <div class="thread">Monthly budget check</div>
              </div>
            </aside>

            <div class="win-chat">
              <div class="chat-feed">
                <div class="msg-user">
                  Pick up where we left off on the store — did we finish separating the support email from my personal inbox?
                </div>

                <div class="tool-fold">
                  <span class="fold-dot"></span>
                  Checked memory &amp; storefront policies · 1.2s
                </div>

                <div class="msg-agent">
                  <p>Yes — we finished that on Thursday and I saved it in your project notes:</p>
                  <ul>
                    <li>Your personal address is off the storefront and policies completely.</li>
                    <li><strong>support@</strong> is live on the new domain. Only thing left on your list was ordering a physical print sample before running ads.</li>
                  </ul>
                </div>
              </div>

              <div class="win-composer">
                <span>Keep talking — even while background work is running…</span>
                <div class="comp-right">
                  <span>On this computer</span>
                  <span class="comp-mic">●</span>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- SCENE 02: IN YOUR POCKET -->
        <div class="app-window scene" data-scene="pair">
          <div class="pair-stage">
            <div class="pair-panel">
              <h3>Walk away from your desk. Keep the thread going.</h3>
              <p>Hand off a long job on your computer, close the lid, and check in from your phone. Your phone talks straight to your computer — nothing sits on a company's cloud in between.</p>
              <div class="pair-state-row">
                <BakenMark uid="sc-pair" size={44} state="connecting" />
                <div>
                  <strong>Paired with one scan</strong>
                  <span>Your phone and your computer, talking directly</span>
                </div>
              </div>
            </div>

            <div class="phone-mock">
              <div class="phone-top">
                <span>Meridian</span>
                <span class="phone-ok">● connected home</span>
              </div>
              <div class="phone-msg-u">Look into why the living room TV kept dropping off Wi-Fi while I'm out.</div>
              <div class="phone-tool">Finished in the background · 2m ago</div>
              <div class="phone-msg-a">
                Found it — disabling the stock setup app wiped the Wi-Fi profile it originally created. Re-saved it under system settings so it won't drop again.
              </div>
              <div class="phone-bar">
                <BakenMark uid="ph-amb" size={18} state="ambient" tight />
                <span>Composer stays open while tasks run</span>
              </div>
            </div>
          </div>
        </div>

        <!-- SCENE 03: ALIVE, NOT A CHATBOT -->
        <div class="app-window scene" data-scene="voice">
          <div class="voice-stage">
            <div class="voice-left">
              <h3>See how it's doing at a glance.</h3>
              <p>Your companion isn't a dead text box. You can see when it's listening, when it's working on something in the background, and when it's resting — and you can talk to it out loud, hands-free.</p>
              <div class="mini-states">
                <div class="ms-pill"><BakenMark uid="ms-load" size={24} state="loading" /> <span>Waking up</span></div>
                <div class="ms-pill"><BakenMark uid="ms-conn" size={24} state="connecting" /> <span>Reconnecting</span></div>
                <div class="ms-pill"><BakenMark uid="ms-amb" size={24} state="ambient" /> <span>Finished a task</span></div>
                <div class="ms-pill"><BakenMark uid="ms-deg" size={24} state="degraded" /> <span>Away from home</span></div>
              </div>
            </div>

            <div class="voice-right">
              <div class="mascot-wrap">
                <svg width="96" height="96" viewBox="-190 -190 380 380" aria-hidden="true">
                  <path d={MASCOT_BODIES.blob} fill="#1E7BF0" />
                  <g transform="rotate(-6)">
                    <rect x="-56" y="-56" width="112" height="112" rx="26" fill="#F7F7F7" />
                    <g class="m-gaze"><g class="eye-blink" set:html={GLYPHS.listening} /></g>
                  </g>
                </svg>
              </div>
              <div class="v-bars" aria-hidden="true">
                <span style="--h:34%"></span><span style="--h:76%"></span><span style="--h:52%"></span>
                <span style="--h:94%"></span><span style="--h:62%"></span><span style="--h:82%"></span>
                <span style="--h:44%"></span>
              </div>
              <span class="voice-tag">Hands-free voice · runs on your own machine</span>
            </div>
          </div>
        </div>
      </div>

      <div class="scene-tabs" id="sceneTabs" role="tablist" aria-label="What Baken does">
        <button type="button" class="scene-tab active" data-target="desktop" role="tab" aria-selected="true">
          Remembers your world
        </button>
        <button type="button" class="scene-tab" data-target="pair" role="tab" aria-selected="false">
          Goes with you on your phone
        </button>
        <button type="button" class="scene-tab" data-target="voice" role="tab" aria-selected="false">
          Talks &amp; works in the background
        </button>
      </div>
    </div>
  </section>

  <!-- HISTORICAL ANCHOR: WHY IT'S CALLED BAKEN (Wadden Sea zeebaken / kaap heritage) -->
  <section class="band band-rule" id="origin">
    <div class="container origin-grid">
      <div class="origin-plate">
        <svg viewBox="0 0 420 260" class="plate-svg" aria-label="Historical Wadden Sea transit diagram">
          <!-- Nautical chart plate frame -->
          <rect x="1" y="1" width="418" height="258" rx="6" fill="none" stroke="currentColor" stroke-opacity="0.18" />
          <rect x="8" y="8" width="404" height="244" rx="3" fill="none" stroke="currentColor" stroke-opacity="0.08" />

          <!-- Shifting tidal sandbank contours -->
          <path d="M 16 198 C 110 166, 230 220, 404 176" fill="none" stroke="currentColor" stroke-opacity="0.16" stroke-dasharray="3 3" />
          <path d="M 16 218 C 140 190, 260 236, 404 198" fill="none" stroke="currentColor" stroke-opacity="0.22" />

          <!-- Line of sight (Kenning) from ship through front & rear baken -->
          <line x1="58" y1="204" x2="346" y2="62" stroke="var(--stone-2)" stroke-width="1.5" stroke-dasharray="4 4" />
          <circle cx="58" cy="204" r="4" fill="currentColor" />

          <!-- Front Baken (shore pebble / buoy) -->
          <g transform="translate(178, 108) scale(0.28)">
            <path d={BAKEN_PEBBLE} fill="var(--stone-2)" />
          </g>
          <!-- Rear Baken (tall standing stone / kaap on the dune) -->
          <g transform="translate(306, 22) scale(0.42)">
            <path d={BAKEN_ANCHOR} fill="currentColor" />
          </g>

          <text x="24" y="30" font-size="10.5" fill="currentColor" fill-opacity="0.6" font-family="ui-monospace, monospace">FIG. I — DE KENNING (LINE OF SIGHT)</text>
          <text x="24" y="236" font-size="10" fill="currentColor" fill-opacity="0.55" font-family="ui-monospace, monospace">TEXEL · VLIELAND · TERSCHELLING (16th–19th C.)</text>
        </svg>
      </div>

      <div class="origin-copy">
        <h2>Why it's called Baken.</h2>
        <p>
          For four hundred years along the Dutch Wadden Sea, the sandbanks shifted with every tide. A chart drawn in spring could ground a ship by autumn. So islanders on Texel, Vlieland, and Terschelling erected <em>bakens</em> — fixed landmarks of stone, iron, and timber set into the dunes.
        </p>
        <p>
          They worked in pairs. When a sailor lined up the smaller front mark against the tall rear mark on the shore — a sightline called a <em>kenning</em> — they knew they were in the safe channel, no matter how the water moved beneath them.
        </p>
        <p>
          AI models shift the same way today: providers change their rules, raise prices, or retire the model you relied on overnight. Baken is the fixed mark you own. The rear stone is your computer, holding years of memory; the front stone is your phone, aligned with it wherever you go.
        </p>
      </div>
    </div>
  </section>

  <!-- FULL-BLEED ELASTIC STRINGS BOARD -->
  <StringsCanvas />

  <!-- WHAT IT ACTUALLY DOES FOR YOU (zero buzzwords) -->
  <section class="band" id="details">
    <div class="container">
      <div class="band-head">
        <h2>Built so it can't be taken<br />away from you tomorrow.</h2>
        <p>When an AI lives in a company's cloud, they decide what it's allowed to remember, how much it costs next month, and when to shut it down. Baken keeps the relationship on your side.</p>
      </div>

      <div class="clean-grid">
        <div class="clean-item">
          <h3>It actually remembers you.</h3>
          <p>Everything your companion learns — your projects, the people in your life, what you decided three months ago — is saved as plain, readable files on your own computer. Open them, edit them, or back them up anytime.</p>
        </div>
        <div class="clean-item">
          <h3>Change the brain, keep the companion.</h3>
          <p>New models come out every month. Because your companion's memory and personality live on your machine, you can swap the underlying AI model whenever you want without starting over from a blank slate.</p>
        </div>
        <div class="clean-item">
          <h3>Never makes you stare at a spinner.</h3>
          <p>Hand off a big task and keep talking, or lock your phone and walk away. Your computer does the heavy lifting in the background and brings the answer back into the conversation when it's ready.</p>
        </div>
        <div class="clean-item">
          <h3>Points at your life, not at the app.</h3>
          <p>No fake streaks for opening the app, no subscription traps, and no guilt notifications. Baken is built to help you ship your work, run your home, and close the app when you're done.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- HOW YOU SET IT UP (genuine 1-2-3 sequence) -->
  <section class="band band-rule" id="pair">
    <div class="container">
      <div class="band-head centered">
        <h2>Up and running in a minute.</h2>
        <p>Your computer holds the memory and does the work. Your phone is your window into it from anywhere.</p>
      </div>

      <div class="steps-row">
        <div class="step">
          <span class="step-idx">1</span>
          <h3>Put Baken on your computer.</h3>
          <p>Run it on the machine you already own — with a local model on your graphics card, or connected to the cloud model you prefer.</p>
          <div class="req">Windows or Linux · local or cloud models</div>
        </div>

        <div class="step">
          <span class="step-idx">2</span>
          <h3>Install the phone app.</h3>
          <p>Download Baken on Android. There is no account to create and nothing to subscribe to.</p>
          <div class="req">Android 8.0 or later · free download</div>
        </div>

        <div class="step">
          <span class="step-idx">3</span>
          <h3>Scan the code on your screen.</h3>
          <p>Point your phone at the code on your computer. They lock directly to each other, encrypted end to end.</p>
          <div class="req">Direct connection · no middleman server</div>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="band band-rule" id="faq">
    <div class="container faq-container">
      <div class="band-head centered">
        <h2>Questions</h2>
      </div>

      <div class="faq-list">
        <details open>
          <summary>What happens if Baken stops being updated tomorrow?</summary>
          <p>Your companion keeps working. The app is open source, it runs on your own machine without calling any server we own, and all of your companion's memory sits in plain text files on your hard drive.</p>
        </details>
        <details>
          <summary>Is Baken free?</summary>
          <p>Yes. Baken is free and open source. If you run local models on your own computer, it costs nothing to run. If you connect a cloud model, you only pay that provider for what you use.</p>
        </details>
        <details>
          <summary>Do I need my own computer?</summary>
          <p>Yes. Your companion lives on a computer or home server you control so that your memory, files, and tools stay in your hands. The phone app connects straight to that computer.</p>
        </details>
        <details>
          <summary>What happens when I switch to a newer AI model?</summary>
          <p>Your companion stays the same. Its memory, history, and habits aren't locked inside OpenAI, Anthropic, or Google — they stay on your machine, and the new model picks right up where the last one left off.</p>
        </details>
        <details>
          <summary>Who can see my conversations?</summary>
          <p>Only you. There is no Baken account and no central cloud database. Your phone and your computer talk directly to each other with a key only the two of them share.</p>
        </details>
      </div>
    </div>
  </section>

  <!-- CLOSING -->
  <section class="band band-rule">
    <div class="container hero-center">
      <BakenMark uid="close" size={48} state="idle" />
      <h2 class="closing-h2">Keep what you build together.</h2>
      <p class="hero-lead" style="margin-bottom:28px">
        Free and open source on Android, Windows, and Linux. No account, no lock-in.
      </p>
      <div class="hero-cta-row">
        <a class="btn btn-primary" href={LINKS.releases} target="_blank" rel="noreferrer" data-umami-event="download-footer">
          Download Baken
        </a>
        <a class="btn btn-outline" href={LINKS.appRepo} target="_blank" rel="noreferrer">
          Source on GitHub
        </a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .hero { padding: 64px 0 88px; }
  .hero-center { display: flex; flex-direction: column; align-items: center; text-align: center; }
  .hero h1 {
    margin: 0 0 22px; font-size: clamp(46px, 6.4vw, 76px);
    line-height: 1.02; letter-spacing: -0.045em; font-weight: 700; max-width: 14ch;
  }
  .hero-lead {
    margin: 0 0 32px; font-size: 17px; line-height: 1.64; color: var(--muted); max-width: 55ch;
  }
  .hero-cta-row { display: flex; flex-wrap: wrap; justify-content: center; gap: 12px; }
  .trust-row {
    margin-top: 24px; display: flex; flex-wrap: wrap; justify-content: center;
    gap: 10px 26px; font-size: 13.5px; color: var(--muted);
  }
  .trust-row span { display: inline-flex; align-items: center; gap: 7px; }
  .trust-row span::before { content: ""; width: 6px; height: 6px; border-radius: 50%; background: var(--stone-2); }

  /* Nautical Chart + Transit Sightline Stage */
  .chart-stage {
    margin-top: 56px; border-radius: 16px; padding: 24px 36px 0;
    background:
      radial-gradient(circle at 50% 18%, rgba(238, 90, 63, 0.14), transparent 48%),
      linear-gradient(165deg, #162836 0%, #0e1b25 55%, #09131a 100%);
    border: 1px solid rgba(220, 230, 238, 0.14);
    box-shadow: 0 24px 64px rgba(6, 13, 19, 0.28);
    overflow: hidden;
  }

  .transit-instrument {
    margin-bottom: 18px;
  }
  .transit-meta {
    display: flex; align-items: center; justify-content: space-between;
    flex-wrap: wrap; gap: 10px;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 11.5px; color: #849BAE;
    padding-bottom: 10px;
    border-bottom: 1px solid rgba(220, 230, 238, 0.1);
  }
  .transit-readout {
    color: #DCE6EE;
  }
  .transit-svg {
    width: 100%; height: auto; display: block;
  }
  .contour {
    fill: none; stroke: rgba(220, 230, 238, 0.11); stroke-width: 1;
  }
  .contour.c2 { stroke-dasharray: 4 4; stroke: rgba(220, 230, 238, 0.15); }
  .contour.c3 { stroke: rgba(220, 230, 238, 0.07); }

  .scene { display: none; }
  .scene.active { display: block; }

  .app-window {
